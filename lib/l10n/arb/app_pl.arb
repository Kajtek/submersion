  "species_giant_kelp_desc": "Strzelisty gatunek tworzący podwodne lasy, dorastający do 60 metrów, symbol nurkowania w Kalifornii.",
  "species_bull_kelp_name": "Kelp byczy",
  "species_bull_kelp_desc": "Pacyficzny kelp z pojedynczym długim trzonkiem i bulwiastym pływakiem, tworzący gęste lasy z baldachimem przy powierzchni.",
  "species_bladder_wrack_name": "Morszczyn pęcherzykowaty",
  "species_bladder_wrack_desc": "Pospolita brunatnica z parzystymi pęcherzami powietrznymi, spotykana w strefie pływów północnego Atlantyku.",
  "species_sargassum_name": "Gronorost",
  "species_sargassum_desc": "Swobodnie unosząca się brunatnica tworząca pływające maty, które dają schronienie młodym rybom i bezkręgowcom.",
  "species_kelp_forest_ecklonia_name": "Kelp Ecklonia",
  "species_kelp_forest_ecklonia_desc": "Dominujący kelp wód półkuli południowej, tworzący ważne podwodne lasy.",
  "species_coralline_algae_name": "Krasnorosty wapienne",
  "species_coralline_algae_desc": "Twardy, inkrustujący krasnorost, który spaja struktury rafy i nadaje rafom różowy odcień.",
  "species_irish_moss_name": "Mech irlandzki",
  "species_irish_moss_desc": "Wachlarzowaty krasnorost spotykany na skalistych brzegach w strefie pływów północnego Atlantyku.",
  "species_dulse_name": "Rodymenia palczasta",
  "species_dulse_desc": "Płaski czerwonofioletowy krasnorost rosnący na skałach i trzonkach kelpu w zimnych wodach północy.",
  "species_halimeda_name": "Halimeda",
  "species_halimeda_desc": "Zwapniała zielenica o dyskowatych członach, jedno z głównych źródeł piasku rafowego.",
  "species_sea_lettuce_name": "Sałata morska",
  "species_sea_lettuce_desc": "Jaskrawozielona, płatowata zielenica spotykana w płytkich wodach przybrzeżnych na całym świecie.",
  "species_caulerpa_name": "Zielone winogrona morskie",
  "species_caulerpa_desc": "Płożąca się zielenica o pędach przypominających winogrona, spotykana na rumoszu rafowym i piasku w tropikach.",
  "species_mermaid_fan_name": "Wachlarz syreny",
  "species_mermaid_fan_desc": "Zwapniała zielenica w kształcie małego wachlarza, pospolita na piaszczystym dnie Karaibów.",
  "species_shaving_brush_algae_name": "Glon pędzel do golenia",
  "species_shaving_brush_algae_desc": "Zwapniała zielenica z kępką przypominającą pędzel na trzonku, spotykana na piaszczystym dnie Karaibów.",
  "species_finger_kelp_name": "Listownica palczasta",
  "species_finger_kelp_desc": "Brunatnica o palczastych plechach, tworząca podwodne łąki w przybrzeżnych wodach północnego Atlantyku.",
  "species_banded_sea_krait_name": "Wiosłogon pręgowany",
  "species_banded_sea_krait_desc": "Jadowity wąż morski w niebieskoszare i czarne pręgi, łagodny i często widywany na rafach Indo-Pacyfiku.",
  "species_olive_sea_snake_name": "Wąż morski oliwkowy",
  "species_olive_sea_snake_desc": "Ciekawski wąż morski spotykany na rafach Australii, znany z tego, że podpływa do nurków.",
  "species_yellow_bellied_sea_snake_name": "Pęz dwubarwny",
  "species_yellow_bellied_sea_snake_desc": "Pelagiczny wąż morski z żółtym spodem ciała, najszerzej rozprzestrzeniony gatunek węża na Ziemi.",
  "species_marine_iguana_name": "Legwan morski",
  "species_marine_iguana_desc": "Endemit Galapagos, jedyna jaszczurka żerująca pod wodą, gdzie zjada glony.",
  "species_saltwater_crocodile_name": "Krokodyl różańcowy",
  "species_saltwater_crocodile_desc": "Największy żyjący gad, spotykany w wodach przybrzeżnych i estuariach Indo-Pacyfiku.",
  "species_northern_pike_name": "Szczupak",
  "species_northern_pike_desc": "Drapieżnik o wydłużonym ciele i kaczym pysku, polujący z zasadzki; wisi nieruchomo wśród roślinności przy brzegach jezior.",
  "species_muskellunge_name": "Muskinong",
  "species_muskellunge_desc": "Największy ze szczupaków, pręgowany lub plamisty olbrzym czystych północnych jezior, rzadko widywany, ale niezapomniany.",
  "species_chain_pickerel_name": "Szczupak czarny",
  "species_chain_pickerel_desc": "Smukły szczupak z zarośniętych stawów wschodniej Ameryki Północnej, zawdzięczający angielską nazwę łańcuszkowemu wzorowi na bokach.",
  "species_walleye_name": "sandacz amerykański",
  "species_walleye_desc": "Złocistooliwkowy krewniak okonia o dużych, odbijających światło oczach, polujący o zmierzchu nad skalistym i piaszczystym dnem jezior.",
  "species_sauger_name": "sandacz kanadyjski",
  "species_sauger_desc": "Mniejszy, bardziej plamisty kuzyn sandacza amerykańskiego, preferujący mętne rzeki i zbiorniki zaporowe.",
  "species_yellow_perch_name": "Okoń żółty",
  "species_yellow_perch_desc": "Ławicowy złocisty okoń z ciemnymi pionowymi pręgami, pospolity przy pomostach i w zaroślach roślin wodnych w całej Ameryce Północnej.",
  "species_european_perch_name": "okoń pospolity",
  "species_european_perch_desc": "Pręgowany okoń o kolczastych płetwach, z czerwonopomarańczowymi płetwami dolnymi, spotykany w niemal każdym europejskim jeziorze i wolno płynącej rzece.",
  "species_zander_name": "Sandacz",
  "species_zander_desc": "Duży jasny drapieżnik o szklistych oczach i szczękach z kłami, patrolujący po zmroku mętne europejskie jeziora i rzeki.",
  "species_ruffe_name": "Jazgarz",
  "species_ruffe_desc": "Mała cętkowana ryba okoniowata z kolczastą, zrośniętą płetwą grzbietową, liczna na miękkim dnie europejskich jezior.",
  "species_largemouth_bass_name": "Bass wielkogębowy",
  "species_largemouth_bass_desc": "Bass o zielonym grzbiecie, z ciemnym pasem na boku i ogromną paszczą, czyhający przy kłodach i skraju roślinności w ciepłych jeziorach.",
  "species_smallmouth_bass_name": "bass małogębowy",
  "species_smallmouth_bass_desc": "Brązowozłoty bass z ledwie widocznymi pionowymi pręgami, trzymający się nad kamieniami i żwirem w czystych, chłodnych jeziorach i rzekach.",
  "species_rock_bass_name": "Bass czerwonooki",
  "species_rock_bass_desc": "Krępa czerwonooka ryba z rodziny bassowatych, z rzędami ciemnych plamek, chroniąca się wśród głazów w czystych strumieniach i jeziorach.",
  "species_bluegill_name": "bass niebieski",
  "species_bluegill_desc": "Dyskowata ryba z rodziny bassowatych, z niebieskoczarnym płatkiem na pokrywie skrzelowej i pomarańczową piersią, gniazdująca kolonijnie na płytkim piaszczystym dnie.",
  "species_pumpkinseed_name": "Bass słoneczny",
  "species_pumpkinseed_desc": "Jaskrawo nakrapiana ryba z rodziny bassowatych, z płatkiem skrzelowym o czerwonym końcu i falistymi niebieskimi liniami na policzkach, pospolita na zarośniętych płyciznach.",
  "species_black_crappie_name": "Krapia czarna",
  "species_black_crappie_desc": "Srebrzysta, wysoko wygrzbiecona ryba w czarne cętki, trzymająca się w ławicach przy zatopionych gałęziach i palach.",
  "species_white_crappie_name": "Krapia biała",
  "species_white_crappie_desc": "Jaśniejsza krapia z ledwie widocznymi pionowymi pręgami, preferująca mętne zbiorniki zaporowe i wolno płynące rzeki.",
  "species_brown_trout_name": "Pstrąg potokowy",
  "species_brown_trout_desc": "Złocistobrązowy pstrąg w czerwone i czarne plamki, trzymający się w nurcie chłodnych, czystych rzek i jezior.",
  "species_rainbow_trout_name": "Pstrąg tęczowy",
  "species_rainbow_trout_desc": "Srebrzysty pstrąg z różowym pasem wzdłuż boku i drobnymi czarnymi cętkami, zarybiany i dziko żyjący w zimnych wodach na całym świecie.",
  "species_brook_trout_name": "Pstrąg źródlany",
  "species_brook_trout_desc": "Palia z robaczkowatym wzorem na grzbiecie, czerwonymi plamkami w niebieskich obwódkach i płetwami o białych krawędziach, żyjąca w zimnych strumieniach górnych odcinków rzek.",
  "species_lake_trout_name": "palia jeziorowa",
  "species_lake_trout_desc": "Duża szara palia pokryta jasnymi plamkami, z wciętym ogonem, przemierzająca głębokie zimne wody północnych jezior.",
  "species_arctic_char_name": "Golec zwyczajny",
  "species_arctic_char_desc": "Najdalej na północ występująca ryba słodkowodna, smukła palia, której brzuch w jesiennej szacie godowej nabiera pomarańczowoczerwonej barwy.",
  "species_atlantic_salmon_name": "łosoś szlachetny",
  "species_atlantic_salmon_desc": "Srebrzysty łosoś wędrowny z czarnymi plamkami w kształcie litery X, pokonujący skokami wodospady w drodze na tarło do rodzinnych rzek.",
  "species_chinook_salmon_name": "czawycza",
  "species_chinook_salmon_desc": "Największy łosoś pacyficzny, o niebieskozielonym grzbiecie i czarnych dziąsłach, wstępujący na tarło do wielkich rzek zachodu Ameryki Północnej.",
  "species_sockeye_salmon_name": "nerka",
  "species_sockeye_salmon_desc": "Łosoś, który na tarło staje się jaskrawoczerwony z zieloną głową i tłumnie zajmuje żwirowiska rzek zasilanych przez jeziora.",
  "species_coho_salmon_name": "kiżucz",
  "species_coho_salmon_desc": "Srebrzysty łosoś o białych dziąsłach, z plamkami tylko na górnej części ogona, trący się w małych przybrzeżnych strumieniach.",
  "species_lake_whitefish_name": "Sieja kanadyjska",
  "species_lake_whitefish_desc": "Srebrzysta sieja o małym pysku, żyjąca w głębokich zimnych jeziorach i żerująca przy dnie w dużych ławicach.",
  "species_cisco_name": "Sielawa amerykańska",
  "species_cisco_desc": "Smukła, podobna do śledzia ryba siejowata, żyjąca w ławicach w toni zimnych północnych jezior; ofiara palii jeziorowej.",
  "species_european_grayling_name": "Lipień pospolity",
  "species_european_grayling_desc": "Srebrzystoszara ryba rzeczna z wysoką, żaglowatą płetwą grzbietową o fioletowym obrzeżeniu, trzymająca się w bystrym nurcie nad czystym żwirem.",
  "species_common_carp_name": "Karp",
  "species_common_carp_desc": "Ciężki brązowozłoty karp o dużych łuskach i z dwoma wąsikami, ryjący w miękkim dnie ciepłych jezior i rzek.",
  "species_grass_carp_name": "Amur biały",
  "species_grass_carp_desc": "Azjatycka ryba karpiowata o torpedowatym kształcie, introdukowana na całym świecie do wyjadania roślinności wodnej, często widywana w czystych jeziorach w kamieniołomach.",
  "species_tench_name": "Lin",
  "species_tench_desc": "Oliwkowozielona ryba o drobnych łuskach, czerwonych oczach i zaokrąglonych płetwach, przemykająca w mule i trzcinach wód stojących.",
  "species_common_bream_name": "Leszcz",
  "species_common_bream_desc": "Wysoka, bocznie spłaszczona brązowozłota ryba żerująca głową w dół w ławicach nad mulistym dnem, pospolita na nizinach Europy.",
  "species_roach_name": "Płoć",
  "species_roach_desc": "Srebrzysta ryba ławicowa o czerwonych płetwach i czerwonej tęczówce, najliczniejsza ryba wielu europejskich jezior i kanałów.",
  "species_rudd_name": "Wzdręga",
  "species_rudd_desc": "Krewniaczka płoci o złocistych bokach, jaskrawoczerwonych płetwach i skierowanym ku górze pysku, żerująca tuż pod powierzchnią.",
  "species_chub_name": "Kleń",
  "species_chub_desc": "Krępa ryba rzeczna o szerokiej głowie, dużych łuskach z ciemnym obrzeżeniem i dużym pysku, trzymająca się pod zwisającymi nad wodą drzewami.",
  "species_barbel_name": "Brzana",
  "species_barbel_desc": "Opływowa ryba denna z czterema wąsikami i dolnym otworem gębowym, trzymająca się żwirowego dna bystrych europejskich rzek.",
  "species_european_eel_name": "Węgorz europejski",
  "species_european_eel_desc": "Wężowata ryba, która spędza dziesiątki lat w rzekach i jeziorach, po czym wędruje do Morza Sargassowego, by odbyć jedyne w życiu tarło.",
  "species_american_eel_name": "Węgorz amerykański",
  "species_american_eel_desc": "Północnoamerykański węgorz, który w rzekach i jeziorach kryje się za dnia pod kamieniami, a na rozród wraca do Morza Sargassowego.",
  "species_burbot_name": "Miętus",
  "species_burbot_desc": "Jedyna słodkowodna ryba dorszowata, cętkowana i podobna do węgorza, z pojedynczym wąsikiem na podbródku, za dnia ukryta w zimnej głębokiej wodzie.",
  "species_channel_catfish_name": "Sumik kanałowy",
  "species_channel_catfish_desc": "Szary sum z rozproszonymi ciemnymi plamkami, wciętym ogonem i ośmioma wąsami, pospolity w rzekach i zbiornikach zaporowych całej Ameryki Północnej.",
  "species_flathead_catfish_name": "sum płaskogłowy",
  "species_flathead_catfish_desc": "Ogromny cętkowany brązowy sum o spłaszczonej głowie i wysuniętej żuchwie, zalegający w głębokich dołach rzecznych.",
  "species_brown_bullhead_name": "Sumik karłowaty",
  "species_brown_bullhead_desc": "Mały krępy sum o ciemnych wąsach i prosto ściętym ogonie, znoszący muliste, ciepłe i ubogie w tlen stawy.",
  "species_wels_catfish_name": "Sum pospolity",
  "species_wels_catfish_desc": "Największa ryba słodkowodna Europy, bezłuski olbrzym o szerokiej płaskiej głowie i długich wąsach, zalegający w głębokich dołach rzecznych.",
  "species_white_sturgeon_name": "jesiotr amerykański",
  "species_white_sturgeon_desc": "Największa ryba słodkowodna Ameryki Północnej, opancerzony szary olbrzym z ogonem jak u rekina, przemierzający wielkie rzeki zachodu kontynentu.",
  "species_lake_sturgeon_name": "Jesiotr jeziorny",
  "species_lake_sturgeon_desc": "Wolno rosnący opancerzony jesiotr z Wielkich Jezior i dorzecza Missisipi, zasysający pokarm z dna rurkowatym pyskiem.",
  "species_european_sturgeon_name": "Jesiotr zachodni",
  "species_european_sturgeon_desc": "Krytycznie zagrożony opancerzony jesiotr rzek zlewiska Atlantyku, dziś hodowany i wypuszczany do Garonny i Łaby.",
  "species_alligator_gar_name": "Niszczuka krokodyla",
  "species_alligator_gar_desc": "Prehistoryczny olbrzym o szerokim uzębionym pysku i pancerzu z rombowatych łusek, wynurzający się w rzekach południa USA, by zaczerpnąć powietrza.",
  "species_longnose_gar_name": "niszczuka długonosa",
  "species_longnose_gar_desc": "Smukła opancerzona ryba o igłowatym pysku, wisząca nieruchomo tuż pod powierzchnią ciepłych rzek.",
  "species_bowfin_name": "Miękławka",
  "species_bowfin_desc": "Żywa skamieniałość o długiej falującej płetwie grzbietowej i kostnej głowie, strzegąca narybku w zarośniętych starorzeczach.",
  "species_american_paddlefish_name": "wiosłonos amerykański",
  "species_american_paddlefish_desc": "Filtrujący pokarm olbrzym z pyskiem w kształcie wiosła, stanowiącym jedną trzecią długości ciała, pływający w wielkich rzekach z otwartą paszczą.",
  "species_sea_lamprey_name": "Minóg morski",
  "species_sea_lamprey_desc": "Bezszczękowy, podobny do węgorza pasożyt z przyssawkowym otworem gębowym otoczonym zębami; po okresie żerowania w morzu lub jeziorach trze się w żwirowych strumieniach.",
  "species_freshwater_drum_name": "Kulbin słodkowodny",
  "species_freshwater_drum_desc": "Srebrzysta garbata ryba, która wydaje słyszalne chrząknięcia i miażdży małże zębami gardłowymi, pospolita w wielkich rzekach i jeziorach.",
  "species_white_sucker_name": "czukuczan biały",
  "species_white_sucker_desc": "Walcowata ryba żerująca przy dnie, z mięsistym pyskiem skierowanym w dół, wiosną tłumnie wstępująca na tarło do strumieni.",
  "species_common_minnow_name": "Strzebla potokowa",
  "species_common_minnow_desc": "Maleńka prążkowana ryba ławicowa czystych, chłodnych strumieni i jezior; samce wiosną przybierają czerwone i zielone barwy.",
  "species_three_spined_stickleback_name": "Ciernik",
  "species_three_spined_stickleback_desc": "Maleńka opancerzona ryba z trzema kolcami na grzbiecie; samce o czerwonym podgardlu budują gniazda z włókien roślinnych i ich strzegą.",
  "species_alewife_name": "Aloza wielkooka",
  "species_alewife_desc": "Srebrzysty śledź, który wiosną wstępuje do rzek, a dziś wypełnia ogromnymi ławicami Wielkie Jeziora.",
  "species_nile_perch_name": "Okoń nilowy",
  "species_nile_perch_desc": "Potężny srebrzysty drapieżnik o oku w czarnej obwódce, introdukowany do Jeziora Wiktorii, gdzie dominuje w otwartej toni.",
  "species_nile_tilapia_name": "Tilapia nilowa",
  "species_nile_tilapia_desc": "Szara pielęgnica z pionowymi pręgami na ogonie, inkubująca potomstwo w pysku, hodowana i zdziczała w ciepłych wodach na całym świecie.",
  "species_african_tigerfish_name": "Afrykańska ryba tygrysia",
  "species_african_tigerfish_desc": "Pręgowany srebrzysty drapieżnik o zazębiających się sztyletowatych zębach, polujący w bystrych afrykańskich rzekach, takich jak Zambezi.",
  "species_marbled_lungfish_name": "Prapłetwiec wielki",
  "species_marbled_lungfish_desc": "Węgorzowata ryba oddychająca powietrzem atmosferycznym, o nitkowatych płetwach, która przetrwa suszę zamknięta w mulistym kokonie.",
  "species_electric_catfish_name": "Sum elektryczny",
  "species_electric_catfish_desc": "Pękaty szary sum z Nilu i Konga, ogłuszający ofiary wyładowaniami o napięciu kilkuset woltów.",
  "species_zebra_mbuna_name": "pyszczak zebra",
  "species_zebra_mbuna_desc": "Skalna pielęgnica z jeziora Malawi w niebieskie pręgi, zeskrobująca glony z głazów w gęstych, terytorialnych skupiskach.",
  "species_malawi_butterfly_peacock_name": "Aulonokara motylowa",
  "species_malawi_butterfly_peacock_desc": "Opalizująca niebieska pielęgnica pawia z jaskiń jeziora Malawi; samce lśnią płetwami o białych krawędziach.",
  "species_fuelleborn_cichlid_name": "Pyszczak błękitny",
  "species_fuelleborn_cichlid_desc": "Tępopyski pyszczak z grupy mbuna z jeziora Malawi, z mięsistym, wystającym nosem do zeskrobywania glonów w strefie przyboju.",
  "species_princess_of_burundi_name": "Księżniczka z Burundi",
  "species_princess_of_burundi_desc": "Elegancka pielęgnica z jeziora Tanganika o lirowatych płetwach, żyjąca w wielopokoleniowych rodzinach, które wspólnie opiekują się gniazdem.",
  "species_frontosa_name": "pyszczak hełmiasty",
  "species_frontosa_desc": "Głębinowa pielęgnica z Tanganiki w wyraziste niebiesko-białe pasy, z garbem na czole, powoli pływająca w grupach nad skałami.",
  "species_tropheus_moorii_name": "Pielęgnica brabancka Moora",
  "species_tropheus_moorii_desc": "Krępa skalna pielęgnica z Tanganiki, występująca w dziesiątkach odmian barwnych, z których każda zajmuje własny odcinek brzegu.",
  "species_arapaima_name": "arapaima piraruku",
  "species_arapaima_desc": "Jedna z największych ryb słodkowodnych, opancerzony amazoński olbrzym z ogonem w czerwone cętki, wynurzający się, by zaczerpnąć powietrza.",
  "species_silver_arowana_name": "Arowana srebrna",
  "species_silver_arowana_desc": "Wstęgowata srebrzysta ryba amazońska z dwoma wąsikami na podbródku, wyskakująca z wody, by chwytać owady z gałęzi.",
  "species_red_bellied_piranha_name": "Pirania Natterera",
  "species_red_bellied_piranha_desc": "Wysoko wygrzbiecona srebrzysta ryba o karmazynowym brzuchu i ostrych jak brzytwa zębach, pływająca w ławicach w amazońskich rozlewiskach.",
  "species_black_piranha_name": "Pirania czarna",
  "species_black_piranha_desc": "Duża samotna pirania o czerwonych oczach i ciemnym, rombowatym ciele, czyhająca w czystych skalistych dopływach Amazonki.",
  "species_red_bellied_pacu_name": "pirapitinga",
  "species_red_bellied_pacu_desc": "Podobny do piranii owocożerca o płaskich miażdżących zębach i czerwonym brzuchu, gromadzący się pod drzewami zalanego lasu.",
  "species_tambaqui_name": "paku czarnopłetwy",
  "species_tambaqui_desc": "Ogromny ciemny paku z Amazonki, rozgryzający opadłe orzechy i nasiona pod okapem zalanego lasu.",
  "species_electric_eel_name": "Strętwa",
  "species_electric_eel_desc": "Nie węgorz, lecz ryba z rzędu strętwokształtnych: długa, ciemna, oddychająca powietrzem atmosferycznym, ogłuszająca ofiary wyładowaniami do 600 woltów.",
  "species_redtail_catfish_name": "Sum czerwonoogonowy",
  "species_redtail_catfish_desc": "Duży amazoński sum o ciemnym grzbiecie, białym brzuchu i jaskrawym pomarańczowoczerwonym ogonie, odpoczywający w głębokich plosach rzek.",
  "species_tiger_shovelnose_catfish_name": "Sum tygrysi",
  "species_tiger_shovelnose_catfish_desc": "Smukły pręgowany sum o długim spłaszczonym pysku, polujący nocą wzdłuż piaszczystych koryt rzek Ameryki Południowej.",
  "species_peacock_bass_name": "pielęgnica pawia",
  "species_peacock_bass_desc": "Agresywna amazońska pielęgnica z trzema ciemnymi pręgami i plamą oczną na ogonie, atakująca ryby z zasadzki przy zatopionym drewnie.",
  "species_oscar_name": "Pielęgnica pawiooka",
  "species_oscar_desc": "Krępa ciemna pielęgnica z pomarańczowym marmurkowaniem i plamą oczną na ogonie, patrolująca wolno płynące wody Amazonii i zalane brzegi.",
  "species_freshwater_angelfish_name": "Żaglowiec skalar",
  "species_freshwater_angelfish_desc": "Wysoka, dyskowata amazońska pielęgnica o wydłużonych płetwach i pionowych pręgach, unosząca się wśród zatopionych korzeni.",
  "species_discus_name": "Paletka",
  "species_discus_desc": "Okrągła, bocznie spłaszczona pielęgnica z falistymi niebieskimi liniami, karmiąca narybek śluzem z własnej skóry.",
  "species_sailfin_pleco_name": "Zbrojnik żaglopłetwy",
  "species_sailfin_pleco_desc": "Opancerzony sum z przyssawkowym otworem gębowym, o wysokiej płetwie grzbietowej i lamparcich cętkach, zeskrobujący glony z drewna i skał.",
  "species_cardinal_tetra_name": "Neon czerwony",
  "species_cardinal_tetra_desc": "Maleńka kąsaczowata rybka z neonowoniebieskim paskiem nad czerwonym pasem biegnącym przez całą długość ciała, pływająca w ławicach w ciemnych wodach Rio Negro.",
  "species_mexican_tetra_name": "lustrzeń meksykański",
  "species_mexican_tetra_desc": "Srebrzysta kąsaczowata ryba z rzek Meksyku, której populacje jaskiniowe są ślepe i blade; ulubienica nurków w cenotach.",
  "species_mekong_giant_catfish_name": "Olbrzymi sum mekoński",
  "species_mekong_giant_catfish_desc": "Krytycznie zagrożony bezzębny olbrzym z Mekongu, szary i pozbawiony wąsów, osiągający niegdyś trzy metry.",
  "species_giant_barb_name": "Karp syjamski",
  "species_giant_barb_desc": "Największa ryba karpiowata świata, olbrzym z Mekongu o dużych łuskach i ogromnej głowie, dziś rzadki w głębokich plosach rzek.",
  "species_asian_arowana_name": "Arowana azjatycka",
  "species_asian_arowana_desc": "Metalicznie czerwona lub złota smocza ryba z czarnowodnych rzek Azji Południowo-Wschodniej, sunąca tuż pod powierzchnią.",
  "species_striped_snakehead_name": "Żmijogłów pręgowany",
  "species_striped_snakehead_desc": "Torpedowaty drapieżnik oddychający powietrzem atmosferycznym, o płaskiej wężowatej głowie, strzegący narybku w zarośniętych azjatyckich stawach.",
  "species_giant_snakehead_name": "Żmijogłów olbrzymi",
  "species_giant_snakehead_desc": "Duży, agresywny żmijogłów, za młodu pręgowany, a po dorośnięciu ciemny, broniący jaskrawoczerwonego narybku w jeziorach Azji Południowo-Wschodniej.",
  "species_climbing_perch_name": "Łaziec",
  "species_climbing_perch_desc": "Wytrzymała oliwkowa ryba, która oddycha powietrzem atmosferycznym i pełza po lądzie między wysychającymi zbiornikami, podpierając się kolczastymi pokrywami skrzelowymi.",
  "species_golden_mahseer_name": "Mahsir złoty",
  "species_golden_mahseer_desc": "Ryba karpiowata o złotych łuskach z himalajskich rzek, silny pływak trzymający się w bystrych, czystych plosach poniżej bystrzy.",
  "species_koi_name": "Karp koi",
  "species_koi_desc": "Ozdobny karp wyhodowany w Japonii w białych, czerwonych, czarnych i złotych wzorach, dobrze czujący się w stawach i ciepłych, czystych jeziorach.",
  "species_goldfish_name": "Karaś chiński",
  "species_goldfish_desc": "Udomowiona azjatycka ryba karpiowata, która na wolności wraca do oliwkowobrązowego ubarwienia i tworzy duże zdziczałe ławice w ciepłych jeziorach.",
  "species_giant_gourami_name": "Gurami olbrzymi",
  "species_giant_gourami_desc": "Szeroka, garbata ryba z Azji Południowo-Wschodniej o nitkowatych płetwach brzusznych, budująca gniazda z piany w wolno płynącej, zarośniętej wodzie.",
  "species_clown_knifefish_name": "Brzeszczotek ozdobny",
  "species_clown_knifefish_desc": "Srebrzysta ryba w kształcie ostrza, z plamami ocznymi wzdłuż długiej falującej płetwy odbytowej, unosząca się pod zatopionymi pniami azjatyckich rzek.",
  "species_walking_catfish_name": "Sum kroczący",
  "species_walking_catfish_desc": "Smukły sum oddychający powietrzem atmosferycznym, który wijąc się, pokonuje mokry grunt między stawami; dziś zdziczały na Florydzie.",
  "species_japanese_eel_name": "Węgorz japoński",
  "species_japanese_eel_desc": "Wschodnioazjatycki węgorz, który dorasta w rzekach i jeziorach, a na tarło wędruje na zachodni Pacyfik.",
  "species_ayu_name": "aju",
  "species_ayu_desc": "Smukła srebrzysta japońska ryba, która zeskrobuje glony z kamieni w czystych rzekach i broni terytorium żerowego.",
  "species_baikal_omul_name": "Omul bajkalski",
  "species_baikal_omul_desc": "Srebrzysta ryba siejowata występująca wyłącznie w Bajkale, pływająca w ławicach w zimnej toni i wstępująca na tarło do rzek.",
  "species_baikal_oilfish_name": "gołomianka duża",
  "species_baikal_oilfish_desc": "Półprzezroczysta, bezłuska ryba z głębin Bajkału, tak bogata w tłuszcz, że niemal przejrzysta, rodząca żywe młode.",
  "species_murray_cod_name": "Dorsz z rzeki Murray",
  "species_murray_cod_desc": "Największa słodkowodna ryba Australii, zielono marmurkowany olbrzym z białym brzuchem, stojący przy zatopionych pniach w dorzeczu Murray-Darling.",
  "species_golden_perch_name": "Okoń złocisty",
  "species_golden_perch_desc": "Wysokogrzbiety, złotooliwkowy okoń śródlądowych rzek Australii, kryjący się przy powalonych drzewach i półkach skalnych.",
  "species_australian_bass_name": "Okoń australijski",
  "species_australian_bass_desc": "Brązowozielony okoń przybrzeżnych rzek wschodniej Australii, który na tarło spływa w dół rzeki do słonawych estuariów.",
  "species_barramundi_name": "barramundi",
  "species_barramundi_desc": "Srebrzysty, garbaty okoń rzek i estuariów północnej Australii, z wiekiem zmieniający płeć z męskiej na żeńską.",
  "species_silver_perch_name": "Okoń srebrzysty",
  "species_silver_perch_desc": "Srebrzystoszary terapon z dorzecza Murray-Darling o małym pysku i rozwidlonym ogonie, niegdyś pływający w ogromnych ławicach.",
  "species_gulf_saratoga_name": "Arowana australijska",
  "species_gulf_saratoga_desc": "Brązowa australijska arowana o łuskach nakrapianych czerwienią, inkubująca ikrę w pysku w północnych starorzeczach (billabongach).",
  "species_sooty_grunter_name": "Terapon smolisty",
  "species_sooty_grunter_desc": "Ciemny, krępy terapon rzek północnej Australii, skubiący glony i owoce wśród skał i bystrzy.",
  "species_eel_tailed_catfish_name": "tandan marmurkowy",
  "species_eel_tailed_catfish_desc": "Australijski sum o zwężającym się, węgorzowatym ogonie, który na czystych rzecznych płyciznach buduje żwirowe gniazdo i go pilnuje.",
  "species_spangled_perch_name": "Terapon cętkowany",
  "species_spangled_perch_desc": "Mały, srebrzyście nakrapiany terapon spotykany w całym interiorze Australii, zasiedlający każde oczko wodne, do którego dotrze powódź.",
  "species_eastern_rainbowfish_name": "Tęczanka wschodnia",
  "species_eastern_rainbowfish_desc": "Mała, opalizująca ryba potoków wschodniej Australii; samce błyskają w słońcu czerwonymi i niebieskimi pasami.",
  "species_signal_crayfish_name": "Rak sygnałowy",
  "species_signal_crayfish_desc": "Duży brązowy rak z białą plamą przy stawie szczypiec, inwazyjny gatunek północnoamerykański rozprzestrzeniający się w rzekach Europy.",
  "species_red_swamp_crayfish_name": "rak luizjański",
  "species_red_swamp_crayfish_desc": "Ciemnoczerwony rak o guzkowatych szczypcach z bagien Luizjany, dziś ryjący nory w ciepłych mokradłach na wszystkich kontynentach.",
  "species_noble_crayfish_name": "Rak szlachetny",
  "species_noble_crayfish_desc": "Rodzimy rak Europy, ciemnobrązowy, o szczypcach czerwonych od spodu, kryjący się w norach brzegowych czystych, chłodnych strumieni i jezior.",
  "species_white_clawed_crayfish_name": "Rak białoszczypcowy",
  "species_white_clawed_crayfish_desc": "Mały oliwkowy rak o jasnym spodzie szczypiec, zagrożony rodzimy mieszkaniec czystych wapiennych strumieni zachodniej Europy.",
  "species_tasmanian_giant_freshwater_crayfish_name": "Tasmański rak olbrzymi",
  "species_tasmanian_giant_freshwater_crayfish_desc": "Największy słodkowodny bezkręgowiec świata, wolno rosnący niebieskobrązowy rak zacienionych rzek Tasmanii.",
  "species_zebra_mussel_name": "Racicznica zmienna",
  "species_zebra_mussel_desc": "Prążkowany małż wielkości paznokcia, tysiącami pokrywający skały, wraki i rury i oczyszczający wodę wszędzie tam, gdzie się rozprzestrzenia.",
  "species_quagga_mussel_name": "racicznica pasiasta",
  "species_quagga_mussel_desc": "Bardziej zaokrąglona i jaśniejsza krewna racicznicy zmiennej, zasiedlająca miękkie dno i głęboką zimną wodę, niedostępne dla tamtej.",
  "species_freshwater_pearl_mussel_name": "Perłoródka rzeczna",
  "species_freshwater_pearl_mussel_desc": "Ciemny, wydłużony małż, który może żyć ponad sto lat, do połowy zagrzebany w czystym żwirze bystrych rzek łososiowych.",
  "species_swan_mussel_name": "Szczeżuja wielka",
  "species_swan_mussel_desc": "Duży małż o cienkiej muszli z mulistych jezior i kanałów, filtrujący wodę syfonami tuż nad mułem.",
  "species_chinese_pond_mussel_name": "Szczeżuja chińska",
  "species_chinese_pond_mussel_desc": "Bardzo duży inwazyjny małż azjatycki o lśniącej brązowej muszli, zawleczony z rybami hodowlanymi i rozprzestrzeniający się w ciepłych jeziorach.",
  "species_freshwater_sponge_name": "Nadecznik stawowy",
  "species_freshwater_sponge_desc": "Zielona lub szara rozgałęziona gąbka porastająca patyki i kamienie w czystych jeziorach, zabarwiona przez żyjące w niej glony.",
  "species_freshwater_jellyfish_name": "hederyka Rydera",
  "species_freshwater_jellyfish_desc": "Przezroczysta meduza wielkości monety, pojawiająca się późnym latem rojami w ciepłych jeziorach wyrobiskowych i zbiornikach zaporowych.",
  "species_great_pond_snail_name": "Błotniarka stawowa",
  "species_great_pond_snail_desc": "Duży ślimak o spiczastej muszli, sunący po roślinach i gładkich jak szkło powierzchniach stojących wód Europy i oddychający powietrzem przy powierzchni.",
  "species_great_ramshorn_snail_name": "Zatoczek rogowy",
  "species_great_ramshorn_snail_desc": "Płaski, spiralnie zwinięty ślimak przypominający maleńki barani róg, zgryzający glony z liści i kamieni w zarośniętych stawach.",
  "species_channeled_apple_snail_name": "Ampularia żłobkowana",
  "species_channeled_apple_snail_desc": "Duży złotobrązowy ślimak składający jaskraworóżowe złoża jaj nad linią wody, inwazyjny na ciepłych mokradłach i polach ryżowych.",
  "species_magnificent_bryozoan_name": "Mszywioł wspaniały",
  "species_magnificent_bryozoan_desc": "Galaretowata kolonia wielkości piłki nożnej, usiana maleńkimi zwierzętami, uczepiona gałęzi i lin w ciepłej stojącej wodzie.",
  "species_chinese_mitten_crab_name": "krab wełnistoszczypcy",
  "species_chinese_mitten_crab_desc": "Ryjący nory krab o owłosionych szczypcach, który spędza lata w rzekach, zanim powędruje w dół rzeki, by rozmnażać się w estuariach.",
  "species_giant_freshwater_prawn_name": "Krewetka olbrzymia słodkowodna",
  "species_giant_freshwater_prawn_desc": "Duża krewetka o niebieskich szczypcach z rzek Azji i Australii; u starych samców szczypce są dłuższe od ciała.",
  "species_common_snapping_turtle_name": "Skorpucha jaszczurowata",
  "species_common_snapping_turtle_desc": "Ciężki żółw o szorstkim pancerzu i długim, piłkowanym ogonie, leżący w mule stawów i wolno płynących rzek z wystawioną głową.",
  "species_alligator_snapping_turtle_name": "skorpucha sępia",
  "species_alligator_snapping_turtle_desc": "Olbrzym o prehistorycznym wyglądzie, z trzema ząbkowanymi grzebieniami na pancerzu i przynętą w kształcie robaka na języku, czekający z otwartą paszczą na dnie rzek południa USA.",
  "species_painted_turtle_name": "Żółw malowany",
  "species_painted_turtle_desc": "Gładki ciemny żółw z czerwonymi i żółtymi paskami na szyi i brzegu pancerza, wygrzewający się rzędami na kłodach w całej Ameryce Północnej.",
  "species_red_eared_slider_name": "Żółw czerwonolicy",
  "species_red_eared_slider_desc": "Żółw wodny w zielone paski z czerwoną smugą za każdym okiem, popularny w handlu zoologicznym, dziś zdziczały w ciepłych wodach całego świata.",
  "species_northern_map_turtle_name": "Żółw mapowy",
  "species_northern_map_turtle_desc": "Oliwkowy żółw z żółtymi liniami na pancerzu przypominającymi mapę i z niskim kilem, wygrzewający się na skałach nad czystymi rzekami i dużymi jeziorami.",
  "species_spiny_softshell_turtle_name": "Żółwiak kolcowaty",
  "species_spiny_softshell_turtle_desc": "Płaski, skórzasty żółw podobny do naleśnika, z ryjkiem jak fajka, zagrzebany w piasku płytkich rzek tak, że widać tylko głowę.",
  "species_florida_softshell_turtle_name": "żółwiak drapieżny",
  "species_florida_softshell_turtle_desc": "Duży ciemny żółwiak z długim, rurkowatym ryjkiem, pospolity w źródłach, kanałach i jeziorach Florydy.",
  "species_pig_nosed_turtle_name": "miękkoskórek dwupazurzasty",
  "species_pig_nosed_turtle_desc": "Niezwykły żółw rzeczny Nowej Gwinei i północnej Australii o płetwach jak u żółwi morskich i mięsistym, świńskim ryjku.",
  "species_mary_river_turtle_name": "Żółw z rzeki Mary",
  "species_mary_river_turtle_desc": "Rzadki australijski żółw, który oddycha przez kloakę i nosi zielony irokez z glonów; żyje w jednej tylko rzece w Queenslandzie.",
  "species_yellow_spotted_river_turtle_name": "Żółw rzeczny żółtoplamy",
  "species_yellow_spotted_river_turtle_desc": "Amazoński żółw bokoszyjny z żółtymi plamami na głowie, wygrzewający się grupami na kłodach i łachach piaszczystych dużych rzek.",
  "species_european_pond_turtle_name": "Żółw błotny",
  "species_european_pond_turtle_desc": "Ciemny żółw nakrapiany żółtymi kropkami, rodzimy słodkowodny żółw Europy, zsuwający się z nasłonecznionych brzegów do zarośniętych stawów.",
  "species_american_alligator_name": "Aligator missisipski",
  "species_american_alligator_desc": "Opancerzony gad o szerokim pysku z bagien, źródeł i rzek południowo-wschodnich Stanów Zjednoczonych, unoszący się tak, że nad wodą widać tylko oczy i nozdrza.",
  "species_spectacled_caiman_name": "kajman okularowy",
  "species_spectacled_caiman_desc": "Mały oliwkowy kajman z kostnym wałem między oczami, liczny w wolno płynących rzekach i lagunach Ameryki Środkowej i Południowej.",
  "species_black_caiman_name": "Kajman czarny",
  "species_black_caiman_desc": "Największy drapieżnik Amazonii, czarny opancerzony kajman długości do pięciu metrów, polujący nocą w jeziorach i zalanym lesie.",
  "species_freshwater_crocodile_name": "krokodyl australijski",
  "species_freshwater_crocodile_desc": "Australijski krokodyl o wąskim pysku z północnych rzek i wąwozów, płochliwy i znacznie mniejszy od krokodyla różańcowego.",
  "species_northern_water_snake_name": "zaskroniec północny",
  "species_northern_water_snake_desc": "Gruby brązowy wąż w poprzeczne pasy, wygrzewający się na skałach i gałęziach nad strumieniami wschodniej Ameryki Północnej; niejadowity, ale skory do kąsania.",
  "species_green_anaconda_name": "Anakonda zielona",
  "species_green_anaconda_desc": "Najcięższy wąż na Ziemi, oliwkowy olbrzym w czarne plamy, leżący w zanurzeniu na bagnach i w wolno płynących rzekach Amazonii.",
  "species_hellbender_name": "Skrytoskrzel diabeł błotny",
  "species_hellbender_desc": "Olbrzymia salamandra o płaskiej głowie i pomarszczonych fałdach skóry, kryjąca się pod dużymi głazami w zimnych, czystych rzekach Appalachów.",
  "species_mudpuppy_name": "Odmieniec amerykański",
  "species_mudpuppy_desc": "Brązowa, plamista salamandra, która przez całe życie zachowuje pierzaste czerwone skrzela i nocą pełza po dnie jezior i rzek.",
  "species_axolotl_name": "Ambystoma meksykańska",
  "species_axolotl_desc": "Uśmiechnięta salamandra ze skrzelami, która nigdy nie opuszcza wody, krytycznie zagrożona w kanałach Xochimilco pod miastem Meksyk.",
  "species_chinese_giant_salamander_name": "salamandra olbrzymia chińska",
  "species_chinese_giant_salamander_desc": "Największy żyjący płaz, pomarszczony brązowy olbrzym długości prawie dwóch metrów, kryjący się w chłodnych, kamienistych górskich potokach.",
  "species_smooth_newt_name": "Traszka zwyczajna",
  "species_smooth_newt_desc": "Mała oliwkowa traszka, co wiosnę wracająca do stawów; samcom wyrasta falisty grzebień, a ich pomarańczowy brzuch pokrywają plamy.",
  "species_great_crested_newt_name": "Traszka grzebieniasta",
  "species_great_crested_newt_desc": "Duża czarna, brodawkowata traszka o ognistopomarańczowym brzuchu; samce w porze godowej noszą postrzępiony, smoczy grzebień.",
  "species_american_bullfrog_name": "Żaba rycząca",
  "species_american_bullfrog_desc": "Ogromna zielona żaba o basowym ryku, siedząca wśród liści lilii wodnych w ciepłych stawach, dziś inwazyjna na kilku kontynentach.",
  "species_common_frog_name": "żaba trawna",
  "species_common_frog_desc": "Brązowa żaba z ciemną maską przy oczach, wiosną zbierająca się w hałaśliwe gromady, by składać skrzek w stawach i rowach Europy.",
  "species_north_american_river_otter_name": "Wydrak kanadyjski",
  "species_north_american_river_otter_desc": "Smukła, skora do zabawy wydra polująca na ryby i raki w rzekach i jeziorach Ameryki Północnej, zostawiająca na brzegach błotne ślizgawki.",
  "species_eurasian_otter_name": "Wydra europejska",
  "species_eurasian_otter_desc": "Płochliwa brązowa wydra rzek, jezior i wybrzeży Europy, po dziesięcioleciach spadku liczebności odradzająca się w całym swoim zasięgu.",
  "species_giant_otter_name": "Arirania amazońska",
  "species_giant_otter_desc": "Niemal dwumetrowa wydra z kremową plamą na gardle, żyjąca w hałaśliwych grupach rodzinnych na rzekach i starorzeczach Amazonii.",
  "species_north_american_beaver_name": "bóbr kanadyjski",
  "species_north_american_beaver_desc": "Duży gryzoń o płaskim ogonie, który tamami spiętrza strumienie w stawy i pływa pod lodem, a schronienie znajduje w żeremiu z gałęzi.",
  "species_eurasian_beaver_name": "Bóbr europejski",
  "species_eurasian_beaver_desc": "Największy gryzoń Europy, reintrodukowany na całym kontynencie, ścinający nadrzeczne drzewa i budujący tamy oraz żeremia.",
  "species_muskrat_name": "piżmak amerykański",
  "species_muskrat_desc": "Brązowy gryzoń wielkości szczura o łuskowatym, spłaszczonym ogonie, pływający wśród szuwarów pałkowych i budujący kopulaste domki z trzciny.",
  "species_platypus_name": "Dziobak australijski",
  "species_platypus_desc": "Jajorodny ssak z kaczym dziobem i błonami pławnymi na łapach, o świcie i zmierzchu żerujący z zamkniętymi oczami w potokach wschodniej Australii.",
  "species_amazonian_manatee_name": "Manat rzeczny",
  "species_amazonian_manatee_desc": "Najmniejszy z manatów, gładki ciemny roślinożerca z białą plamą na piersi, skubiący rośliny wodne w jeziorach i rzekach Amazonii.",
  "species_amazon_river_dolphin_name": "Inia amazońska",
  "species_amazon_river_dolphin_desc": "Różowy delfin o długim dziobie i giętkiej szyi, lawirujący między pniami zalanego lasu w dorzeczach Amazonki i Orinoko.",
  "species_baikal_seal_name": "Nerpa bajkalska",
  "species_baikal_seal_desc": "Jedyna na świecie foka słodkowodna, mała i srebrzystoszara, wylegująca się na lodzie i skalistych brzegach Bajkału.",
  "species_capybara_name": "Kapibara wielka",
  "species_capybara_desc": "Największy gryzoń, beczkowaty roślinożerca, który w spokojnych stadach brodzi i pływa w rzekach i na mokradłach Ameryki Południowej.",
  "species_hippopotamus_name": "Hipopotam nilowy",
  "species_hippopotamus_desc": "Potężny olbrzym afrykańskich rzek, który spędza dzień w zanurzeniu w stadzie i raczej chodzi po dnie, niż pływa; zbliżanie się do niego jest niebezpieczne.",
  "species_white_water_lily_name": "Grzybienie białe",
  "species_white_water_lily_desc": "Okrągłe pływające liście i duże białe kwiaty wyrastające z grubych kłączy zakorzenionych w mule stojących wód Europy.",
  "species_yellow_pond_lily_name": "Grążel żółty",
  "species_yellow_pond_lily_desc": "Sercowate pływające liście i kubkowate żółte kwiaty, a pod wodą duże, prześwitujące liście podwodne, które nurkowie widzą od spodu.",
  "species_american_eelgrass_name": "nurzaniec amerykański",
  "species_american_eelgrass_desc": "Taśmowate liście długości do dwóch metrów, falujące w prądzie czystych rzek i źródeł, przysmak manatów.",
  "species_coontail_name": "Rogatek sztywny",
  "species_coontail_desc": "Zanurzona roślina bez korzeni, z okółkami sztywnych, widlasto rozgałęzionych liści przypominającymi ogon szopa, unosząca się gęstymi kłębami w stojącej wodzie.",
  "species_eurasian_watermilfoil_name": "Wywłócznik kłosowy",
  "species_eurasian_watermilfoil_desc": "Pierzasta roślina zanurzona z okółkami drobno podzielonych liści, tworząca przy powierzchni gęste kożuchy, inwazyjna w wielu jeziorach.",
  "species_muskgrass_name": "ramienica pospolita",
  "species_muskgrass_desc": "Krucha zielenica o piżmowym zapachu i okółkowych gałązkach, często inkrustowana wapieniem, wyścielająca dno czystych jezior o twardej wodzie.",
  "species_canadian_waterweed_name": "Moczarka kanadyjska",
  "species_canadian_waterweed_desc": "Gęsta roślina zanurzona z okółkami trzech małych ciemnozielonych liści, rozprzestrzeniająca się z fragmentów pędów w chłodnych jeziorach i kanałach całego świata.",
  "species_curly_leaf_pondweed_name": "rdestnica kędzierzawa",
  "species_curly_leaf_pondweed_desc": "Roślina zanurzona o czerwonawozielonych liściach z falistym brzegiem, podobnych do pomarszczonej lasagne, rosnąca wczesną wiosną przed innymi roślinami wodnymi.",
  "species_water_hyacinth_name": "pontederia gruboogonkowa",
  "species_water_hyacinth_desc": "Roślina pływająca o lśniących liściach na wypełnionych powietrzem ogonkach i kłosach lawendowych kwiatów, zarastająca ciepłe drogi wodne na całym świecie.",
  "species_common_reed_name": "Trzcina pospolita",
  "species_common_reed_desc": "Wysoka trawa o pierzastych wiechach, tworząca gęste łany wzdłuż brzegów jezior; jej zanurzone łodygi dają schronienie narybkowi i larwom ważek.",
