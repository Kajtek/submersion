  "media_gearGallery_count": "{count, plural, =1{{count} zdjęcie} few{{count} zdjęcia} many{{count} zdjęć} other{{count} zdjęcia}}",
  "media_gearGallery_empty": "Tutaj pojawiają się zdjęcia dodane do twojego sprzętu i jego kontroli.",
