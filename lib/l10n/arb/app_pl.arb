  "species_blue_spotted_stingray_desc": "Mała rafowa ogończa z rozsianymi niebieskimi plamkami, często zagrzebana w piasku.",
  "species_southern_stingray_name": "Ogończa amerykańska",
  "species_southern_stingray_desc": "Duża ogończa spotykana na piaszczystych płyciznach Karaibów, słynna ze Stingray City.",
  "species_round_stingray_name": "Ogończa okrągła",
  "species_round_stingray_desc": "Mała, okrągła ogończa, pospolita na płytkich piaszczystych obszarach wschodniego Pacyfiku.",
  "species_short_tail_stingray_name": "Ogończa krótkoogonowa",
  "species_short_tail_stingray_desc": "Jedna z największych ogończy, spotykana w umiarkowanych wodach półkuli południowej.",
  "species_cowtail_stingray_name": "Ogończa pióroogonowa",
  "species_cowtail_stingray_desc": "Duża, ciemna ogończa z charakterystycznym fałdem ogona przypominającym chorągiewkę, spotykana na piaszczystych rafach.",
  "species_atlantic_torpedo_ray_name": "Drętwa atlantycka",
  "species_atlantic_torpedo_ray_desc": "Płaszczka elektryczna zdolna do silnych wyładowań, spotykana na piaszczystym dnie Atlantyku.",
  "species_marbled_electric_ray_name": "Drętwa pstra",
  "species_marbled_electric_ray_desc": "Śródziemnomorska płaszczka elektryczna o marmurkowym deseniu, zdolna porazić odczuwalnym wyładowaniem.",
  "species_giant_guitarfish_name": "Rocha olbrzymia",
  "species_giant_guitarfish_desc": "Płaszczka o kształcie rekina, spotykana na piaszczystym dnie Indo-Pacyfiku w pobliżu raf koralowych.",
  "species_shovelnose_guitarfish_name": "Rocha łopatonosa",
  "species_shovelnose_guitarfish_desc": "Spłaszczona ryba o kształcie pośrednim między płaszczką a rekinem, pospolita na piaszczystych płyciznach wschodniego Pacyfiku.",
  "species_smalltooth_sawfish_name": "Piła drobnozębna",
  "species_smalltooth_sawfish_desc": "Krytycznie zagrożona płaszczka z uzębionym rostrum, spotykana w tropikalnych wodach przybrzeżnych.",
  "species_green_sawfish_name": "Piła zielona",
  "species_green_sawfish_desc": "Duża ryba piła o oliwkowozielonym ciele, zamieszkująca estuaria zachodniego Indo-Pacyfiku.",
  "species_devil_ray_name": "Mobula olbrzymia",
  "species_devil_ray_desc": "Duża mobula z płetwami głowowymi, widywana, gdy grupami wyskakuje z wody.",
  "species_spinetail_devil_ray_name": "Mobula kolcoogonowa",
  "species_spinetail_devil_ray_desc": "Pelagiczna mobula często widywana w dużych skupiskach przy powierzchni.",
  "species_lesser_devil_ray_name": "Mobula karłowata",
  "species_lesser_devil_ray_desc": "Najmniejszy gatunek mobuli, tworzący duże ławice w Zatoce Kalifornijskiej.",
  "species_bat_ray_name": "Orleń kalifornijski",
  "species_bat_ray_desc": "Płaszczka o romboidalnym kształcie, pospolita w lasach wodorostów i piaszczystych zatokach Kalifornii.",
  "species_undulate_ray_name": "Raja falista",
  "species_undulate_ray_desc": "Pięknie ubarwiona raja z falistymi liniami, spotykana we wschodnim Atlantyku.",
  "species_thornback_ray_name": "Raja nabijana",
  "species_thornback_ray_desc": "Pospolita europejska raja z ostrymi kolcami wzdłuż grzbietu i ogona.",
  "species_cownose_ray_name": "Płaszczka krowionosa",
  "species_cownose_ray_desc": "Charakterystyczna wcięta głowa; często widywana w dużych ławicach podczas sezonowych wędrówek.",
  "species_marble_ray_name": "Ogończa marmurkowa",
  "species_marble_ray_desc": "Duża, ciemna ogończa z białymi plamami, często widywana przy stacjach czyszczących Indo-Pacyfiku.",
  "species_ocellate_river_stingray_name": "Płaszczka motoro",
  "species_ocellate_river_stingray_desc": "Słodkowodna płaszczka z efektownymi plamami w pomarańczowych obwódkach, pochodząca z rzek Ameryki Południowej.",
  "species_ocellaris_clownfish_name": "Błazenek okoniowy",
  "species_ocellaris_clownfish_desc": "Mała ryba w pomarańczowo-białe pasy, żyjąca w symbiozie z ukwiałami na rafach koralowych.",
  "species_clarkii_clownfish_name": "Błazenek Clarka",
  "species_clarkii_clownfish_desc": "Wytrzymały błazenek o ciemnym ciele z dwoma białymi pasami, spotykany w całym Indo-Pacyfiku w różnych gatunkach ukwiałów.",
  "species_tomato_clownfish_name": "Błazenek pomidorowy",
  "species_tomato_clownfish_desc": "Jaskrawy czerwonopomarańczowy błazenek z jednym białym pasem na głowie, pospolity na rafach Indo-Pacyfiku.",
  "species_regal_blue_tang_name": "Pokolec królewski",
  "species_regal_blue_tang_desc": "Intensywnie niebieski pokolec z czarnym rysunkiem w kształcie palety i żółtym ogonem, spotykany na rafach koralowych Indo-Pacyfiku.",
  "species_yellow_tang_name": "Zebrasoma żółta",
  "species_yellow_tang_desc": "Jaskrawożółty pokolec pospolity na rafach Hawajów i Pacyfiku, często widywany w grupach zgryzających glony.",
  "species_powder_blue_surgeonfish_name": "Pokolec białobrody",
  "species_powder_blue_surgeonfish_desc": "Efektowny jasnoniebieski pokolec z czarną głową i żółtą płetwą grzbietową, spotykany w Oceanie Indyjskim.",
  "species_sohal_surgeonfish_name": "Pokolec arabski",
  "species_sohal_surgeonfish_desc": "Wyraziście pręgowany pokolec z pomarańczowym kolcem ogonowym, endemit raf Morza Czerwonego i Zatoki Perskiej.",
  "species_blue_tang_name": "Pokolec błękitny",
  "species_blue_tang_desc": "Ciemnoniebieski pokolec pospolity na rafach Karaibów; młode osobniki są jaskrawożółte.",
  "species_emperor_angelfish_name": "Ustnik cesarski",
  "species_emperor_angelfish_desc": "Duży ustnik w efektowne niebieskie i żółte poziome pasy. Młode osobniki mają koncentryczne niebiesko-białe kręgi.",
  "species_french_angelfish_name": "Ustnik francuski",
  "species_french_angelfish_desc": "Duży, ciemny ustnik o łuskach ze złotym obrzeżeniem, zwykle widywany w parach na rafach Karaibów i zachodniego Atlantyku.",
  "species_queen_angelfish_name": "Ustnik królewski",
  "species_queen_angelfish_desc": "Wspaniały niebiesko-żółty ustnik z charakterystyczną plamą w kształcie korony, spotykany na karaibskich rafach koralowych.",
  "species_regal_angelfish_name": "Ustnik książęcy",
  "species_regal_angelfish_desc": "Elegancki ustnik w naprzemienne pomarańczowo-białe i niebieskie pionowe pasy, spotykany na rafach Indo-Pacyfiku.",
  "species_rock_beauty_name": "Ustnik trójbarwny",
  "species_rock_beauty_desc": "Efektowny karaibski ustnik z żółtą przednią i czarną tylną połową ciała, spotykany przy skalistych rafach i nawisach.",
  "species_gray_angelfish_name": "Ustnik szary",
  "species_gray_angelfish_desc": "Duży szary ustnik z jasnym pyskiem i żółtą wewnętrzną stroną płetwy piersiowej, pospolity na rafach Karaibów.",
  "species_copperband_butterflyfish_name": "Pensetnik miedzianopręgi",
  "species_copperband_butterflyfish_desc": "Charakterystyczny chetonik z pomarańczowymi pionowymi pasami i wydłużonym pyskiem, spotykany na rafach Indo-Pacyfiku.",
  "species_raccoon_butterflyfish_name": "Chetonik szopi",
  "species_raccoon_butterflyfish_desc": "Żółty chetonik z ciemną maską wokół oczu jak u szopa, pospolity na rafach Indo-Pacyfiku i Hawajów.",
  "species_longnose_butterflyfish_name": "Pensetnik żółty",
  "species_longnose_butterflyfish_desc": "Jaskrawożółty chetonik z niezwykle długim pyskiem, którym wybiera pokarm ze szczelin na rafach Indo-Pacyfiku.",
  "species_threadfin_butterflyfish_name": "Chetonik nitkopłetwy",
  "species_threadfin_butterflyfish_desc": "Biały chetonik z jodełkowym wzorem i nitkowatym wyrostkiem płetwy grzbietowej, szeroko rozprzestrzeniony w Indo-Pacyfiku.",
  "species_foureye_butterflyfish_name": "Chetonik czterooki",
  "species_foureye_butterflyfish_desc": "Jasny chetonik z wyraźną fałszywą plamą oczną przy ogonie, pospolity na rafach Karaibów.",
  "species_spotfin_butterflyfish_name": "Chetonik plamopłetwy",
  "species_spotfin_butterflyfish_desc": "Biało-żółty chetonik z małą ciemną plamką na płetwie grzbietowej, spotykany w zachodnim Atlantyku.",
  "species_banner_butterflyfish_name": "Kabuba czerwonomorska",
  "species_banner_butterflyfish_desc": "Czarno-biała kabuba z wydłużoną płetwą grzbietową i żółtym brzuchem, endemit Morza Czerwonego.",
  "species_moorish_idol_name": "Idolek mauretański",
  "species_moorish_idol_desc": "Charakterystyczna ryba rafowa w wyraziste czarne, białe i żółte pasy, z długim nitkowatym wyrostkiem płetwy grzbietowej.",
  "species_green_moray_eel_name": "Murena zielona",
  "species_green_moray_eel_desc": "Duża zielona murena dorastająca do 2,5 m, często widywana z otwartym pyskiem w szczelinach raf zachodniego Atlantyku.",
  "species_giant_moray_eel_name": "Murena olbrzymia",
  "species_giant_moray_eel_desc": "Największy gatunek mureny, osiągający ponad 3 m, z cętkami jak u lamparta. Spotykany na rafach koralowych Indo-Pacyfiku.",
  "species_spotted_moray_eel_name": "Murena plamista",
  "species_spotted_moray_eel_desc": "Biała murena w ciemnobrązowe plamy, często spotykana na Karaibach, gdy wygląda z otworów w rafie.",
  "species_ribbon_eel_name": "Murena wstążkowa",
  "species_ribbon_eel_desc": "Smukła murena z rozszerzonymi nozdrzami; samce są intensywnie niebieskie, samice żółte. Spotykana w piaszczystych lagunach Indo-Pacyfiku.",
  "species_spotted_garden_eel_name": "Węgorz ogrodowy plamisty",
  "species_spotted_garden_eel_desc": "Cienki biały węgorz w czarne plamki, żyjący w koloniach na piasku i kołyszący się w prądzie, by chwytać plankton.",
  "species_splendid_garden_eel_name": "Węgorz ogrodowy wspaniały",
  "species_splendid_garden_eel_desc": "Węgorz ogrodowy w pomarańczowo-białe pręgi, tworzący duże kolonie na piasku w zachodnim Pacyfiku.",
  "species_snowflake_moray_name": "Murena gwiaździsta",
  "species_snowflake_moray_desc": "Mała murena o białym ciele z czarnym rysunkiem przypominającym płatki śniegu, pospolita w rumoszu rafowym Indo-Pacyfiku.",
  "species_mandarin_dragonet_name": "Mandaryn wspaniały",
  "species_mandarin_dragonet_desc": "Maleńka, olśniewająco ubarwiona ryba w psychodeliczne niebiesko-pomarańczowe wzory, spotykana w strefach rumoszu zachodniego Pacyfiku.",
  "species_common_lionfish_name": "Skrzydlica pstra",
  "species_common_lionfish_desc": "Jadowita ryba ze skorpenowatych z efektownymi wachlarzowatymi płetwami piersiowymi, w czerwono-białe pasy. Inwazyjna na Karaibach.",
  "species_leaf_scorpionfish_name": "Skorpena liściowata",
  "species_leaf_scorpionfish_desc": "Silnie bocznie spłaszczona skorpena w kształcie liścia, kołysząca się w prądzie i udająca dryfujące szczątki na rafach Indo-Pacyfiku.",
  "species_stonefish_name": "Szkaradnica rafowa",
  "species_stonefish_desc": "Najbardziej jadowita ryba świata, doskonale zamaskowana jako kamień na dnie raf Indo-Pacyfiku. Skrajnie niebezpieczna.",
  "species_painted_frogfish_name": "Żabnica malowana",
  "species_painted_frogfish_desc": "Krępy drapieżnik polujący z zasadzki, z wabikiem na głowie i bardzo zmiennym ubarwieniem. Spotykany na rafach Indo-Pacyfiku.",
  "species_giant_frogfish_name": "Żabnica olbrzymia",
  "species_giant_frogfish_desc": "Największy gatunek żabnicy, dorastający do 40 cm, znakomicie zamaskowany wśród gąbek i rumoszu koralowego.",
  "species_hairy_frogfish_name": "Żabnica włochata",
  "species_hairy_frogfish_desc": "Żabnica pokryta mięsistymi wyrostkami podobnymi do robaków, które naśladują glony; cenione znalezisko dla fotografów podwodnych.",
  "species_clown_triggerfish_name": "Rogatnica jasnoplama",
  "species_clown_triggerfish_desc": "Wyraziście ubarwiona rogatnica z dużymi białymi plamami na ciemnym ciele i żółtymi wargami, spotykana na rafach Indo-Pacyfiku.",
  "species_titan_triggerfish_name": "Rogatnica tytan",
  "species_titan_triggerfish_desc": "Duża, agresywna rogatnica znana z atakowania nurków w pobliżu gniazda. Pospolita na rafach koralowych Indo-Pacyfiku.",
  "species_queen_triggerfish_name": "Rogatnica królewska",
  "species_queen_triggerfish_desc": "Barwna karaibska rogatnica z niebieskim rysunkiem na głowie i długimi wstęgami płetwy ogonowej.",
  "species_picasso_triggerfish_name": "Rogatnica Picasso",
  "species_picasso_triggerfish_desc": "Rogatnica z abstrakcyjnym wzorem niebieskich, żółtych i czarnych pasów, pospolita na płyciznach rafowych Indo-Pacyfiku.",
  "species_yellowmargin_triggerfish_name": "Rogatnica żółtobrzega",
  "species_yellowmargin_triggerfish_desc": "Duża płowa rogatnica o płetwach z żółtym obrzeżeniem, znana z agresywnej obrony gniazda na rafach Indo-Pacyfiku.",
  "species_porcupinefish_name": "Najeżka",
  "species_porcupinefish_desc": "Duża kolczasta ryba, która w razie zagrożenia nadyma się w kulę, spotykana na rafach tropikalnych całego świata.",
  "species_guineafowl_pufferfish_name": "Rozdymka perlicza",
  "species_guineafowl_pufferfish_desc": "Ciemna rozdymka pokryta drobnymi białymi plamkami, na rafach Indo-Pacyfiku spotykana czasem w złotożółtej odmianie barwnej.",
  "species_map_pufferfish_name": "Rozdymka mapowa",
  "species_map_pufferfish_desc": "Duża jasna rozdymka z misternym ciemnym rysunkiem na całym ciele, przypominającym mapę, spotykana na rafach Indo-Pacyfiku.",
  "species_sharpnose_pufferfish_name": "Rozdymka ostronosa",
  "species_sharpnose_pufferfish_desc": "Maleńka rozdymka z niebieskimi liniami na głowie i pomarańczowym ogonem, często widywana na rafach Karaibów.",
  "species_boxfish_name": "Kostera żółta",
  "species_boxfish_desc": "Młode osobniki to jaskrawożółte sześciany w czarne kropki. Dorosłe ciemnieją do barwy niebieskoszarej. Spotykana w całym Indo-Pacyfiku.",
  "species_cowfish_name": "Kostera rogata",
  "species_cowfish_desc": "Pudełkowata żółta ryba z charakterystycznymi wyrostkami przypominającymi rogi nad każdym okiem, spotykana na rafach Indo-Pacyfiku.",
  "species_napoleon_wrasse_name": "Wargacz garbogłowy (napoleon)",
  "species_napoleon_wrasse_desc": "Potężny wargacz dorastający do 2 m, z wydatnym garbem na czole. Zagrożony i chroniony, spotykany na rafach Indo-Pacyfiku.",
  "species_cleaner_wrasse_name": "Wargatek sanitarnik",
  "species_cleaner_wrasse_desc": "Mały wargacz z niebieskim pasem, prowadzący stacje czyszczące, w których usuwa pasożyty z większych ryb na rafach Indo-Pacyfiku.",
  "species_yellowtail_coris_name": "Koris żółtoogonowy",
  "species_yellowtail_coris_desc": "Barwny wargacz o cętkowanym ciele i żółtym ogonie; młode osobniki są jaskrawo pomarańczowoczerwone z białymi plamami.",
  "species_bluehead_wrasse_name": "Wargacz niebieskogłowy",
  "species_bluehead_wrasse_desc": "Liczny karaibski wargacz; samce w fazie terminalnej mają intensywnie niebieską głowę i zielone ciało z czarno-białymi pasami.",
  "species_spanish_hogfish_name": "Wargacz hiszpański",
  "species_spanish_hogfish_desc": "Fioletowo-żółty wargacz pospolity na rafach Karaibów; młode osobniki pełnią rolę czyścicieli.",
  "species_bumphead_parrotfish_name": "Papugoryba garbogłowa",
  "species_bumphead_parrotfish_desc": "Największy gatunek papugoryby, dorastający do 1,3 m, z masywnym garbem na czole. Wędruje ławicami po rafach Indo-Pacyfiku.",
  "species_stoplight_parrotfish_name": "Papugoryba zielona",
  "species_stoplight_parrotfish_desc": "Pospolita karaibska papugoryba, której ubarwienie diametralnie zmienia się między fazą początkową a terminalną.",
  "species_queen_parrotfish_name": "Papugoryba królewska",
  "species_queen_parrotfish_desc": "Duża niebieskozielona papugoryba spotykana na rafach Karaibów, często widywana, gdy odgryza koral, żerując na glonach.",
  "species_yellowtail_damselfish_name": "Garbik żółtoogonowy",
  "species_yellowtail_damselfish_desc": "Ciemnoniebieski garbik z jaskrawożółtym ogonem, pospolity na szczytach i grzbietach raf Karaibów.",
  "species_sergeant_major_name": "Garbik pięciopręgi (sierżant)",
  "species_sergeant_major_desc": "Srebrzystożółty garbik z pięcioma wyraźnymi czarnymi pręgami, tworzący duże skupiska na rafach tropikalnego Atlantyku.",
  "species_three_spot_damselfish_name": "Garbik trójplamy",
  "species_three_spot_damselfish_desc": "Ciemnobrązowy terytorialny garbik, agresywnie broniący swojego ogródka glonów na rafach Karaibów.",
  "species_chromis_viridis_name": "Chromis zielony",
  "species_chromis_viridis_desc": "Mały, opalizująco zielony garbik widywany w dużych ławicach unoszących się nad koralami gałęzistymi na rafach Indo-Pacyfiku.",
  "species_blue_chromis_name": "Chromis niebieski",
  "species_blue_chromis_desc": "Olśniewająco niebieski planktonożerny garbik, tworzący duże skupiska w toni nad ścianami raf Karaibów.",
  "species_nassau_grouper_name": "Granik nassauski",
  "species_nassau_grouper_desc": "Duży karaibski granik z charakterystycznym ciemnym pasem przez oko i pręgowanym wzorem, dziś zagrożony z powodu przełowienia.",
  "species_giant_grouper_name": "Granik olbrzymi",
  "species_giant_grouper_desc": "Największa kostnoszkieletowa ryba rafowa, osiągająca 2,7 m i 400 kg. Spotykana w jaskiniach i wrakach całego Indo-Pacyfiku.",
  "species_coral_grouper_name": "Strzępiel koralowy",
  "species_coral_grouper_desc": "Jaskrawy czerwonopomarańczowy strzępiel pokryty niebieskimi plamkami, gatunek wizytówka raf koralowych Indo-Pacyfiku.",
  "species_goliath_grouper_name": "Granik goliat",
  "species_goliath_grouper_desc": "Potężny atlantycki granik dorastający do 2,5 m, często spotykany przy wrakach i nawisach na Florydzie i Karaibach.",
  "species_potato_grouper_name": "Granik ziemniaczany",
  "species_potato_grouper_desc": "Duży, przyjazny granik z ciemnymi plamami w kształcie ziemniaków, słynny z Cod Hole na Wielkiej Rafie Koralowej.",
  "species_peacock_grouper_name": "Strzępiel pawi",
  "species_peacock_grouper_desc": "Ciemnobrązowy strzępiel z jaskrawoniebieskimi plamkami i jasnymi pionowymi pasami w tylnej części ciała, pospolity na rafach Indo-Pacyfiku.",
  "species_yellowfin_tuna_name": "Tuńczyk żółtopłetwy",
  "species_yellowfin_tuna_desc": "Szybki drapieżnik pelagiczny z długą żółtą płetwą grzbietową i odbytową, czasem widywany przez nurków w miejscach z dala od brzegu.",
  "species_dogtooth_tuna_name": "Tuńczyk psiozębny",
  "species_dogtooth_tuna_desc": "Silny tuńczyk związany z rafą, o wydatnych zębach, spotykany przy głębokich stokach raf Indo-Pacyfiku.",
  "species_great_barracuda_name": "Barakuda wielka",
  "species_great_barracuda_desc": "Smukły srebrzysty drapieżnik do 1,8 m długości, o wydatnych zębach, często wiszący nieruchomo w toni przy rafach tropikalnych.",
  "species_blackfin_barracuda_name": "Barakuda czarnopłetwa",
  "species_blackfin_barracuda_desc": "Indopacyficzna barakuda znana z tworzenia ogromnych ławic przypominających tornado w miejscach nurkowych takich jak Barracuda Point.",
  "species_mahi_mahi_name": "Koryfena",
  "species_mahi_mahi_desc": "Olśniewająca niebieskozielono-złota ryba pelagiczna o tępym czole, czasem widywana w miejscach nurkowych z dala od brzegu.",
  "species_giant_trevally_name": "Karanks olbrzymi",
  "species_giant_trevally_desc": "Silny srebrzysty drapieżnik do 1,7 m długości, znany z polowań w kanałach rafowych i przy stokach raf Indo-Pacyfiku.",
  "species_bluefin_trevally_name": "Karanks niebieskopłetwy",
  "species_bluefin_trevally_desc": "Smukły karanks w niebieskie plamki, często patrolujący krawędzie raf Indo-Pacyfiku w małych grupach łowieckich.",
  "species_bigeye_trevally_name": "Karanks wielkooki",
  "species_bigeye_trevally_desc": "Srebrzysty karanks o dużych oczach, tworzący imponujące wirujące ławice przy ścianach raf i stacjach czyszczących.",
  "species_bar_jack_name": "Karanks smugowy",
  "species_bar_jack_desc": "Smukły srebrzysty karanks karaibski z charakterystycznym ciemnoniebieskim pasem biegnącym wzdłuż grzbietu aż na dolny płat ogona.",
  "species_horse_eye_jack_name": "Karanks końskooki",
  "species_horse_eye_jack_desc": "Srebrzysty karanks o dużych oczach, tworzący ławice przy rafach i wrakach Karaibów i zachodniego Atlantyku.",
  "species_yellowtail_snapper_name": "Lucjan żółtoogonowy",
  "species_yellowtail_snapper_desc": "Smukły lucjan z żółtym pasem na boku i żółtym ogonem, często widywany w ławicach w toni na rafach Karaibów.",
  "species_schoolmaster_snapper_name": "Lucjan nauczyciel",
  "species_schoolmaster_snapper_desc": "Żółtosrebrzysty lucjan z niebieskimi liniami pod okiem, spotykany w grupach pod nawisami na rafach Karaibów.",
  "species_bluestripe_snapper_name": "Lucjan błękitnopasy",
  "species_bluestripe_snapper_desc": "Jaskrawożółty lucjan z czterema niebieskimi poziomymi pasami, tworzący gęste ławice na rafach Indo-Pacyfiku.",
  "species_twinspot_snapper_name": "Lucjan dwuplamy",
  "species_twinspot_snapper_desc": "Duży czerwony lucjan spotykany na zewnętrznych rafach Indo-Pacyfiku, czasem tworzący ławice przy głębokich ścianach i w kanałach.",
  "species_humphead_snapper_name": "Lucjan nocny",
  "species_humphead_snapper_desc": "Duży ciemny lucjan spotykany w ławicach przy stromych stokach raf Indo-Pacyfiku; młode osobniki są kontrastowo czarno-białe.",
  "species_longfin_bannerfish_name": "Kabuba długopłetwa",
  "species_longfin_bannerfish_desc": "Czarno-biała ryba z długą, ciągnącą się płetwą grzbietową i żółtym ogonem, często widywana w parach na rafach Indo-Pacyfiku.",
  "species_batfish_orbicular_name": "Plataks okrągły",
  "species_batfish_orbicular_desc": "Srebrzysta ryba w kształcie dysku, z wysokimi płetwami, z ciekawością podpływająca do nurków. Pospolita na wrakach i rafach Indo-Pacyfiku.",
  "species_batfish_teira_name": "Plataks długopłetwy",
  "species_batfish_teira_desc": "Plataks o wysokich płetwach z ciemną plamą przy płetwie piersiowej, często widywany przy stacjach czyszczących i wrakach.",
  "species_batfish_pinnatus_name": "Plataks pierzasty",
  "species_batfish_pinnatus_desc": "Młode osobniki są kruczoczarne z jaskrawopomarańczowym obrzeżeniem i przypominają trującego płazińca. Spotykany w zachodnim Pacyfiku.",
  "species_banggai_cardinalfish_name": "Apogon z Banggai",
  "species_banggai_cardinalfish_desc": "Efektowny srebrno-czarny apogon o wydłużonych płetwach, endemit indonezyjskich wysp Banggai.",
  "species_pajama_cardinalfish_name": "Apogon piżamowy",
  "species_pajama_cardinalfish_desc": "Niezwykły apogon z żółtą głową, ciemnym pasem w połowie ciała i nakrapianym tyłem, spotykany wśród koralowców Indo-Pacyfiku.",
  "species_longnose_hawkfish_name": "Strażnik długonosy",
  "species_longnose_hawkfish_desc": "Mała biała ryba z czerwonym kratkowanym wzorem i wydłużonym pyskiem, przesiadująca na gorgoniach i czarnych koralach.",
  "species_arc_eye_hawkfish_name": "Strażnik łukooki",
  "species_arc_eye_hawkfish_desc": "Mały strażnik z charakterystycznym pomarańczowym łukiem za okiem, często przesiadujący na blokach koralowych raf Indo-Pacyfiku.",
  "species_flame_hawkfish_name": "Strażnik płomienisty",
  "species_flame_hawkfish_desc": "Jaskrawoczerwony strażnik z ciemnym rysunkiem wokół oczu, przesiadujący w koralach Pocillopora w zachodnim Pacyfiku.",
  "species_fire_goby_name": "Babka ognista",
  "species_fire_goby_desc": "Elegancka biała babka z wysoką pierwszą płetwą grzbietową i czerwonopomarańczowym ogonem, unosząca się nad rumoszem rafowym Indo-Pacyfiku.",
  "species_purple_firefish_name": "Babka purpurowa",
  "species_purple_firefish_desc": "Delikatna babka z fioletowymi płetwami i wysokim kolcem grzbietowym, unosząca się w pobliżu norek na zewnętrznych rafach Indo-Pacyfiku.",
  "species_yellownose_goby_name": "Babka żółtonosa",
  "species_yellownose_goby_desc": "Maleńka karaibska babka czyściciel z żółtym pyskiem i niebieskim pasem na boku, spotykana na gąbkach i blokach koralowych.",
  "species_citron_goby_name": "Babka cytrynowa",
  "species_citron_goby_desc": "Maleńka jaskrawożółta babka żyjąca wśród gałęzi korali Acropora na rafach Indo-Pacyfiku.",
  "species_shrimp_goby_name": "Babka krewetkowa Steinitza",
  "species_shrimp_goby_desc": "Babka w kolorze piasku, dzieląca norkę z krewetką pistoletową w układzie mutualistycznym na piaszczystych płyciznach Indo-Pacyfiku.",
  "species_neon_goby_name": "Babka neonowa",
  "species_neon_goby_desc": "Maleńka ciemna babka z jaskrawym neonowoniebieskim pasem, prowadząca stacje czyszczące na karaibskich blokach koralowych.",
  "species_bluestriped_fangblenny_name": "Ślizg szablozębny niebieskopręgi",
  "species_bluestriped_fangblenny_desc": "Mały ślizg w niebieskie pasy, który upodabnia się do wargatków czyścicieli, by odgryzać łuski niczego niepodejrzewającym rybom.",
  "species_sailfin_blenny_name": "Ślizg żaglopłetwy",
  "species_sailfin_blenny_desc": "Maleńki karaibski ślizg, który ze swojej rurki mieszkalnej stawia dużą, podobną do żagla płetwę grzbietową, by zwabić partnerki.",
  "species_bicolor_blenny_name": "Ślizg dwubarwny",
  "species_bicolor_blenny_desc": "Mały ślizg z ciemnobrązową przednią i pomarańczową tylną połową ciała, wyglądający z otworów na rafach Indo-Pacyfiku.",
  "species_redlip_blenny_name": "Ślizg czerwonowargi",
  "species_redlip_blenny_desc": "Ciemny ślizg z wydatnymi czerwonopomarańczowymi wargami, broniący płatów glonów na grzbietach raf Karaibów.",
  "species_pygmy_seahorse_name": "Karłowaty konik morski Bargibanta",
  "species_pygmy_seahorse_desc": "Maleńki konik morski poniżej 2 cm, idealnie upodobniony do gorgonii, na której żyje; ceniony obiekt makrofotografii.",
  "species_common_seahorse_name": "Konik morski pospolity",
  "species_common_seahorse_desc": "Średniej wielkości konik morski spotykany na łąkach trawy morskiej i w rumoszu koralowym Indo-Pacyfiku, o zmiennym ubarwieniu.",
  "species_thorny_seahorse_name": "Konik morski kolczasty",
  "species_thorny_seahorse_desc": "Konik morski pokryty długimi kolcami, spotykany na łąkach trawy morskiej i miękkim dnie Indo-Pacyfiku.",
  "species_ornate_ghost_pipefish_name": "Iglicznia widmowa ozdobna",
  "species_ornate_ghost_pipefish_desc": "Misternie zamaskowana iglicznia, unosząca się głową w dół przy liliowcach i koralach miękkich Indo-Pacyfiku.",
  "species_robust_ghost_pipefish_name": "Iglicznia widmowa krępa",
  "species_robust_ghost_pipefish_desc": "Duża iglicznia widmowa udająca trawę morską lub glony, często spotykana w parach w wodach przybrzeżnych Indo-Pacyfiku.",
  "species_trumpetfish_name": "Trąbik",
  "species_trumpetfish_desc": "Długa, smukła ryba polująca w cieniu większych ryb, spotykana w różnych barwach na rafach Karaibów i Atlantyku.",
  "species_cornetfish_name": "Fistulka",
  "species_cornetfish_desc": "Niezwykle wydłużona ryba do 1,5 m długości, z nitkowatym wyrostkiem ogona, często widywana, gdy sunie nad płyciznami rafowymi.",
  "species_yellowhead_jawfish_name": "Szczękacz żółtogłowy",
  "species_yellowhead_jawfish_desc": "Mała ryba o niebieskim ciele i żółtej głowie, unosząca się nad swoją norką w piasku na rafach Karaibów. Samce inkubują ikrę w pysku.",
  "species_flamefish_name": "Apogon płomienisty",
  "species_flamefish_desc": "Mały jaskrawoczerwony apogon z ciemną plamą pod drugą płetwą grzbietową, za dnia ukryty w szczelinach raf Karaibów.",
  "species_longspine_squirrelfish_name": "Hajduk długokolcy",
  "species_longspine_squirrelfish_desc": "Czerwona nocna ryba o dużych oczach i długim kolcu grzbietowym, za dnia spotykana pod nawisami na rafach Karaibów.",
  "species_soldierfish_name": "Żołnierzyk wielkołuski",
  "species_soldierfish_desc": "Czerwona nocna ryba o ogromnych ciemnych oczach i dużych łuskach, za dnia tworząca grupy w jaskiniach i pod nawisami.",
  "species_flame_angelfish_name": "Ustniczek płomienisty",
  "species_flame_angelfish_desc": "Jaskrawy czerwonopomarańczowy ustniczek z czarnymi pionowymi pasami i niebieskimi końcami płetw, spotykany w całym Pacyfiku.",
  "species_royal_gramma_name": "Gramma królewska",
  "species_royal_gramma_desc": "Mała dwubarwna ryba karaibska z fioletową przednią i żółtą tylną połową ciała, spotykana pod nawisami.",
  "species_anthias_lyretail_name": "Antias liroogonowy",
  "species_anthias_lyretail_desc": "Liczna ryba rafowa tworząca duże pomarańczowo-różowe chmury nad formacjami koralowymi Indo-Pacyfiku. Samce są fioletowe.",
  "species_mediterranean_grouper_name": "Granik wielki",
  "species_mediterranean_grouper_desc": "Duży ciemnobrązowy granik z jasnym marmurkowaniem, sztandarowy drapieżnik skalistych raf Morza Śródziemnego.",
  "species_mediterranean_moray_name": "Murena śródziemnomorska",
  "species_mediterranean_moray_desc": "Ciemnobrązowa murena z żółtym marmurkowaniem, często widywana w Morzu Śródziemnym, gdy wygląda ze skalnych szczelin.",
  "species_ornate_wrasse_name": "Talasoma pawia",
  "species_ornate_wrasse_desc": "Barwny zielony wargacz z czerwonym rysunkiem na głowie, jeden z najpospolitszych wargaczy na rafach Morza Śródziemnego.",
  "species_red_sea_bannerfish_name": "Chetonik maskowy",
  "species_red_sea_bannerfish_desc": "Jaskrawożółty chetonik z ciemną plamą wokół oka, endemit Morza Czerwonego. Często widywany w parach.",
  "species_red_sea_anemonefish_name": "Błazenek czerwonomorski",
  "species_red_sea_anemonefish_desc": "Pomarańczowożółty błazenek z dwoma białymi pasami, endemit Morza Czerwonego i Zatoki Adeńskiej.",
  "species_arabian_angelfish_name": "Ustnik arabski",
  "species_arabian_angelfish_desc": "Duży ciemnoniebieski ustnik z wyrazistym żółtym pionowym pasem i żółtym ogonem, endemit zachodniego Oceanu Indyjskiego.",
  "species_king_angelfish_name": "Ustnik monarszy",
  "species_king_angelfish_desc": "Duży ciemnoniebieski ustnik z białym pionowym pasem i żółtym ogonem, spotykany we wschodnim Pacyfiku i na Galapagos.",
  "species_ocean_sunfish_name": "Samogłów",
  "species_ocean_sunfish_desc": "Najcięższa ryba kostnoszkieletowa, osiągająca ponad 2 tony. Czasem widywana przez nurków przy stacjach czyszczących na Bali i Galapagos.",
  "species_lingcod_name": "Lingkod",
  "species_lingcod_desc": "Duża, cętkowana drapieżna terpuga spotykana na skalistych rafach północno-zachodniego wybrzeża Pacyfiku, często pilnująca złożonej ikry.",
  "species_wolf_eel_name": "Zębacz węgorzowaty",
  "species_wolf_eel_desc": "Duży szary zębacz o wężowatym ciele, z bulwiastą głową i potężnymi szczękami, spotykany w skalnych kryjówkach północno-zachodniego wybrzeża Pacyfiku.",
  "species_giant_sea_bass_name": "Wrakoń olbrzymi",
  "species_giant_sea_bass_desc": "Potężna ryba okoniokształtna osiągająca ponad 2 m i 250 kg, spotykana na skalistych rafach i w lasach wodorostów u wybrzeży południowej Kalifornii.",
  "species_garibaldi_name": "Garbik garibaldi",
  "species_garibaldi_desc": "Jaskrawopomarańczowy garbik, oficjalna ryba morska stanu Kalifornia, terytorialny na rafach w lasach wodorostów.",
  "species_sheephead_name": "Wargacz kalifornijski",
  "species_sheephead_desc": "Duży wargacz z czarną głową i ogonem, czerwonym środkiem ciała i białym podbródkiem. Spotykany w kalifornijskich lasach wodorostów.",
  "species_copper_rockfish_name": "Karmazyn miedziany",
  "species_copper_rockfish_desc": "Miedzianopomarańczowy karmazyn z jasnymi plamami, częsty widok na skalistych rafach i w lasach wodorostów północno-zachodniego wybrzeża Pacyfiku.",
  "species_oriental_sweetlips_name": "Słodkousty orientalny",
  "species_oriental_sweetlips_desc": "Duża ryba rafowa Indo-Pacyfiku w wyraziste czarno-białe pasy, z żółtymi płetwami. Młode osobniki wykonują wijący się taniec.",
  "species_harlequin_sweetlips_name": "Słodkousty arlekin",
  "species_harlequin_sweetlips_desc": "Dorosłe osobniki są szare w ciemne plamki; młode są brązowe z dużymi białymi plamami i pływają falującym ruchem.",
  "species_blue_ringed_angelfish_name": "Ustnik pierścieniowy",
  "species_blue_ringed_angelfish_desc": "Duży brązowy ustnik z niebieskimi łukowatymi liniami i charakterystycznym niebieskim pierścieniem nad pokrywą skrzelową.",
  "species_yellowbar_angelfish_name": "Ustnik żółtopręgi",
  "species_yellowbar_angelfish_desc": "Duży szaroniebieski ustnik z wyraźną żółtą plamą na boku, spotykany w Morzu Czerwonym i zachodnim Oceanie Indyjskim.",
  "species_filefish_scrawled_name": "Jednorożek pisany",
  "species_filefish_scrawled_desc": "Duży oliwkowobrązowy jednorożek z niebieskim rysunkiem przypominającym bazgroły i pomarańczowym fałdem podgardla, spotykany na rafach tropikalnych całego świata.",
  "species_clown_filefish_name": "Jednorożek pomarańczowoplamy",
  "species_clown_filefish_desc": "Mały zielony jednorożek w pomarańczowe plamki, z długim pyskiem, żywiący się wyłącznie polipami korali Acropora.",
  "species_unicornfish_name": "Pokolec jednorogi",
  "species_unicornfish_desc": "Szary pokolec z wydatnym rogiem na czole i dwoma niebieskimi kolcami u nasady ogona, pospolity na płyciznach rafowych Indo-Pacyfiku.",
  "species_surgeonfish_sailfin_name": "Zebrasoma żaglopłetwa",
  "species_surgeonfish_sailfin_desc": "Wyraziście pręgowany pokolec z silnie powiększoną płetwą grzbietową i odbytową, spotykany w całym Indo-Pacyfiku.",
  "species_achilles_tang_name": "Pokolec Achillesa",
  "species_achilles_tang_desc": "Ciemnobrązowy pokolec z wyrazistą pomarańczową plamą w kształcie łzy przy ogonie, spotykany w strefach przyboju środkowego Pacyfiku.",
  "species_doctorfish_name": "Pokolec chirurg",
  "species_doctorfish_desc": "Szarobrązowy pokolec ze słabo widocznymi ciemnymi pręgami i wydatnym kolcem u nasady ogona, pospolity na rafach Karaibów.",
  "species_checkerboard_wrasse_name": "Wargacz szachownicowy",
  "species_checkerboard_wrasse_desc": "Barwny wargacz z szachownicowym wzorem zielonych, różowych i czarnych pól na całym ciele.",
  "species_bird_wrasse_name": "Wargacz ptasi",
  "species_bird_wrasse_desc": "Wargacz z niezwykle wydłużonym pyskiem przypominającym ptasi dziób; samce są ciemnozielone, samice brązowe.",
  "species_sling_jaw_wrasse_name": "Wargacz o wysuwanej szczęce",
  "species_sling_jaw_wrasse_desc": "Wargacz z wysuwaną szczęką, która wystrzeliwuje do przodu, by pochwycić ofiarę; występuje w odmianie żółtej lub brązowej.",
  "species_peacock_flounder_name": "Flądra pawia",
  "species_peacock_flounder_desc": "Płaska ryba denna w niebieskie pierścienie i plamki, potrafiąca zmieniać ubarwienie, by dopasować się do dna.",
  "species_hogfish_name": "Wargacz świniopyski",
  "species_hogfish_desc": "Duży wargacz zachodniego Atlantyku z pyskiem przypominającym świński ryj i wydłużonymi kolcami płetwy grzbietowej, spotykany przy rafach i wrakach.",
  "species_tarpon_name": "Tarpon atlantycki",
  "species_tarpon_desc": "Ogromna srebrzysta ryba o dużych, lustrzanych łuskach, czasem spotykana przez nurków w jaskiniach i kanałach Karaibów.",
  "species_permit_name": "Sierpik (permit)",
  "species_permit_desc": "Wysokogrzbiety srebrzysty karanks z ciemnym, rozwidlonym ogonem, spotykany na piaszczystych płyciznach Karaibów i przy rafach.",
  "species_spotted_drum_name": "Kulbin plamisty",
  "species_spotted_drum_desc": "Efektowna karaibska ryba z wysoką, wydłużoną płetwą grzbietową i wyrazistym wzorem czarno-białych plam.",
  "species_jackknife_fish_name": "Kulbin lancetowaty",
  "species_jackknife_fish_desc": "Elegancka karaibska ryba z czarnym pasem na wysokiej płetwie grzbietowej i ukośną pręgą na ciele, spotykana pod nawisami.",
  "species_bigeye_name": "Wielkook szklisty",
  "species_bigeye_desc": "Jaskrawoczerwona nocna ryba o dużych, odbijających światło oczach, ukrywająca się w jaskiniach raf Karaibów i Atlantyku.",
  "species_remora_name": "Podnawka",
  "species_remora_desc": "Smukła ryba z przyssawką na głowie, podróżująca na gapę na rekinach, płaszczkach, żółwiach i innych dużych zwierzętach.",
  "species_tilefish_sand_name": "Płytecznik piaskowy",
  "species_tilefish_sand_desc": "Wydłużona jasnoniebieska ryba, która usypuje kopce z rumoszu na piaszczystych obszarach raf Karaibów.",
  "species_weedy_seadragon_name": "Pławikonik australijski",
  "species_weedy_seadragon_desc": "Ozdobny krewny koników morskich z wyrostkami przypominającymi liście, endemit umiarkowanych wód południowej Australii.",
  "species_leafy_seadragon_name": "Pławikonik grzywiasty",
  "species_leafy_seadragon_desc": "Widowiskowy smok morski pokryty misternymi wyrostkami w kształcie liści, endemit południowej Australii. Obserwacja z listy nurkowych marzeń.",
  "species_sailfin_snapper_name": "Lucjan żaglopłetwy",
  "species_sailfin_snapper_desc": "Elegancki żółto-niebieski lucjan z wydłużoną płetwą grzbietową i odbytową, spotykany na stokach raf Indo-Pacyfiku.",
  "species_sweetlip_emperor_name": "Letra mglista",
  "species_sweetlip_emperor_desc": "Duża srebrzysta letra z niebieskimi liniami na głowie i żółtymi krawędziami płetw, pospolita nad piaszczystymi obszarami raf Indo-Pacyfiku.",
  "species_crocodilefish_name": "Ryba krokodyl",
  "species_crocodilefish_desc": "Płaskogłowy drapieżnik polujący z zasadzki, z misternymi frędzlami nad oczami, leżący doskonale zamaskowany na dnie raf Indo-Pacyfiku.",
  "species_devil_scorpionfish_name": "Skorpena diabelska",
  "species_devil_scorpionfish_desc": "Krępa, zamaskowana skorpena, która w ostrzeżeniu przed drapieżnikami błyska barwną wewnętrzną stroną płetw piersiowych.",
  "species_spiny_devilfish_name": "Szkaradnica demon",
  "species_spiny_devilfish_desc": "Jadowity mieszkaniec dna, który chodzi na przekształconych promieniach płetw, a zaniepokojony błyska jaskrawymi płetwami piersiowymi.",
  "species_waspfish_name": "Skorpena kakadu",
  "species_waspfish_desc": "Mała, bocznie spłaszczona skorpena, kołysząca się w prądzie jak martwy liść na mulistym dnie Indo-Pacyfiku.",
  "species_stargazer_name": "Skaber białobrzegi",
  "species_stargazer_desc": "Drapieżnik polujący z zasadzki, zagrzebujący się w piasku tak, że widać tylko oczy; potrafi razić prądem. Spotykany w Indo-Pacyfiku.",
  "species_striped_catfish_name": "Sumik koralowy",
  "species_striped_catfish_desc": "Sumik z jadowitymi kolcami; młode osobniki tworzą gęste kuliste ławice, które toczą się po dnie raf Indo-Pacyfiku.",
  "species_red_emperor_name": "Lucjan cesarski",
  "species_red_emperor_desc": "Duży lucjan; dorosłe osobniki są różowoczerwone, młode mają wyraziste czerwono-białe pręgi. Spotykany na rafach Indo-Pacyfiku.",
  "species_mangrove_snapper_name": "Lucjan namorzynowy",
  "species_mangrove_snapper_desc": "Szary lucjan spotykany w karaibskich namorzynach, na łąkach trawy morskiej i rafach, często gromadzący się przy podwodnych konstrukcjach.",
  "species_dottyback_orchid_name": "Pseudochromis orchidowy",
  "species_dottyback_orchid_desc": "Mała intensywnie fioletowa ryba, endemit Morza Czerwonego, śmigająca do szczelin i z powrotem na stromych ścianach raf.",
  "species_dottyback_royal_name": "Pseudochromis królewski",
  "species_dottyback_royal_desc": "Mała dwubarwna ryba z przodem w kolorze magenty i jaskrawożółtym tyłem, spotykana na ścianach raf Indo-Pacyfiku.",
  "species_coral_trout_name": "Strzępiel lamparci",
  "species_coral_trout_desc": "Ceniony drapieżnik Wielkiej Rafy Koralowej o pomarańczowoczerwonym ciele pokrytym niebieskimi plamkami.",
  "species_barramundi_cod_name": "Granik garbaty",
  "species_barramundi_cod_desc": "Charakterystyczny granik z małą głową, garbatym ciałem i ciemnymi kropkami na jasnym tle.",
  "species_spadefish_atlantic_name": "Szpadelek atlantycki",
  "species_spadefish_atlantic_desc": "Srebrzysta ryba w kształcie dysku z ciemnymi pionowymi pręgami, często widywana w dużych ławicach wokół karaibskich wraków.",
  "species_fusilier_yellowback_name": "Fizylier żółtogrzbiety",
  "species_fusilier_yellowback_desc": "Smukła niebieska ryba planktonożerna z żółtym grzbietem, tworząca ogromne ławice nad stokami raf Indo-Pacyfiku.",
  "species_fusilier_bluestreak_name": "Fizylier niebieskopręgi",
  "species_fusilier_bluestreak_desc": "Mały niebieski fizylier z ciemnym pasem na boku, widywany w szybko płynących ławicach wzdłuż ścian raf Indo-Pacyfiku.",
  "species_porkfish_name": "Chrząkacz prosiaczek",
  "species_porkfish_desc": "Barwny karaibski chrząkacz w niebieskie i żółte pasy, z dwiema czarnymi pręgami na głowie, spotykany przy rafach i wrakach.",
  "species_blue_striped_grunt_name": "Chrząkacz niebieskopręgi",
  "species_blue_striped_grunt_desc": "Żółty karaibski chrząkacz w intensywnie niebieskie poziome pasy, za dnia tworzący duże odpoczywające ławice pod nawisami.",
  "species_french_grunt_name": "Chrząkacz francuski",
  "species_french_grunt_desc": "Mały chrząkacz w żółte pasy, w ciągu dnia tworzący gęste odpoczywające ławice na rafach Karaibów.",
  "species_convict_tang_name": "Pokolec pręgowany",
  "species_convict_tang_desc": "Jasny pokolec z sześcioma pionowymi czarnymi pręgami, często widywany w dużych ławicach żerujących na płyciznach rafowych Indo-Pacyfiku.",
  "species_great_hammerhead_name": "Głowomłot tropikalny",
  "species_great_hammerhead_desc": "Charakterystyczny rekin o głowie w kształcie młota z falistą krawędzią, tworzący duże ławice przy górach podwodnych i wyspach z dala od lądu.",
  "species_wobbegong_name": "Brodacz plamisty",
  "species_wobbegong_desc": "Płaski, dobrze zamaskowany rekin dywanowy z frędzlowatymi wyrostkami wokół pyska, spotykany na rafach umiarkowanych wód Australii.",
  "species_manta_ray_name": "Manta rafowa",
  "species_manta_ray_desc": "Pełen gracji olbrzym o rozpiętości płetw do 5 m, odwiedzający stacje czyszczące i żywiący się planktonem na rafach Indo-Pacyfiku.",
  "species_oceanic_manta_name": "Manta oceaniczna",
  "species_oceanic_manta_desc": "Największy gatunek płaszczki, o rozpiętości płetw przekraczającej 7 m, spotykany przy górach podwodnych z dala od brzegu i stacjach czyszczących.",
  "species_undulated_moray_name": "Murena falista",
  "species_undulated_moray_desc": "Żółtawozielona murena z ciemnym falistym rysunkiem, często widywana nocą podczas polowania na rafach Indo-Pacyfiku.",
  "species_whitemouth_moray_name": "Murena białopyska",
  "species_whitemouth_moray_desc": "Ciemnobrązowa murena w drobne białe plamki, z charakterystycznym białym wnętrzem pyska, spotykana w całym Indo-Pacyfiku.",
  "species_dragon_moray_name": "Murena smocza",
  "species_dragon_moray_desc": "Efektowna murena ze smoczymi rogami nad nozdrzami i pomarańczowoczerwonymi lamparcimi cętkami, spotykana w Indo-Pacyfiku.",
  "species_lyretail_grouper_name": "Strzępiel liroogonowy",
  "species_lyretail_grouper_desc": "Czerwonoróżowy strzępiel w niebieskie plamki, z charakterystycznym ogonem w kształcie półksiężyca, spotykany na zewnętrznych ścianach raf Indo-Pacyfiku.",
  "species_banded_butterflyfish_name": "Chetonik pręgowany",
  "species_banded_butterflyfish_desc": "Biały chetonik z czterema wyrazistymi czarnymi pionowymi pręgami, jeden z najpospolitszych chetoników na rafach Karaibów.",
  "species_ringed_pipefish_name": "Iglicznia obrączkowana",
  "species_ringed_pipefish_desc": "Smukła iglicznia w naprzemienne czerwone i białe obrączki, spotykana w jaskiniach i pod nawisami na rafach Indo-Pacyfiku.",
  "species_razorfish_name": "Brzytewka",
  "species_razorfish_desc": "Niewielka ryba pływająca w grupach pionowo, głową w dół, często ukryta wśród kolców jeżowców na rafach Indo-Pacyfiku.",
  "species_harlequin_tuskfish_name": "Wargacz arlekin",
  "species_harlequin_tuskfish_desc": "Barwny wargacz o jaskrawoniebieskich kłach, czerwonopomarańczowych pręgach i białych plamach, spotykany na rafach zachodniego Pacyfiku.",
  "species_blue_groper_name": "Wargacz błękitny",
  "species_blue_groper_desc": "Duży niebieski wargacz, endemit wschodniej Australii, ufny i często podpływający do nurków na rafach strefy umiarkowanej.",
  "species_red_lipped_batfish_name": "Nietoperznik czerwonowargi",
  "species_red_lipped_batfish_desc": "Osobliwa ryba o spłaszczonym ciele i jaskrawoczerwonych wargach, chodząca po dnie Galapagos na przekształconych płetwach.",
  "species_orangeband_surgeonfish_name": "Pokolec pomarańczowopręgi",
  "species_orangeband_surgeonfish_desc": "Szarobrązowy pokolec z pomarańczową poziomą pręgą za okiem, spotykany na stokach raf Pacyfiku.",
  "species_maori_wrasse_name": "Wargacz maoryski",
  "species_maori_wrasse_desc": "Średniej wielkości wargacz z ciemną pręgą za płetwą piersiową, pospolity na rafach Pacyfiku i Oceanu Indyjskiego.",
  "species_blue_ringed_octopus_name": "Ośmiornica niebieskopierścieniowa",
  "species_blue_ringed_octopus_desc": "Mała, ale niezwykle jadowita ośmiornica z jaskrawoniebieskimi pierścieniami, które rozbłyskują w razie zagrożenia.",
  "species_common_octopus_name": "Ośmiornica zwyczajna",
  "species_common_octopus_desc": "Bardzo inteligentna ośmiornica znana z błyskawicznych zmian ubarwienia i umiejętności rozwiązywania problemów.",
  "species_giant_pacific_octopus_name": "Ośmiornica olbrzymia",
  "species_giant_pacific_octopus_desc": "Największy gatunek ośmiornicy, o rozpiętości ramion przekraczającej 4 metry, żyjący w zimnych wodach Pacyfiku.",
  "species_mimic_octopus_name": "Ośmiornica mimik",
  "species_mimic_octopus_desc": "Niezwykła ośmiornica naśladująca wygląd i zachowanie innych morskich gatunków.",
  "species_coconut_octopus_name": "Ośmiornica kokosowa",
  "species_coconut_octopus_desc": "Mała ośmiornica słynąca z noszenia łupin kokosa i używania ich jako przenośnych kryjówek.",
  "species_day_octopus_name": "Ośmiornica dzienna",
  "species_day_octopus_desc": "Aktywny za dnia łowca, pospolity na rafach Indo-Pacyfiku, o imponujących zdolnościach kamuflażu.",
  "species_wonderpus_octopus_name": "Ośmiornica wonderpus",
  "species_wonderpus_octopus_desc": "Efektowna ośmiornica o niepowtarzalnych biało-brązowych pręgach, spotykana na piaszczystych miejscach nurkowych typu muck.",
  "species_broadclub_cuttlefish_name": "Mątwa szerokoramienna",
  "species_broadclub_cuttlefish_desc": "Duża mątwa o hipnotyzujących pokazach barw, często widywana na rafach Indo-Pacyfiku.",
  "species_pharaoh_cuttlefish_name": "Mątwa faraońska",
  "species_pharaoh_cuttlefish_desc": "Duża mątwa spotykana w całym Oceanie Indyjskim, znana z pulsujących wzorów barwnych.",
  "species_flamboyant_cuttlefish_name": "Mątwa płomienista",
  "species_flamboyant_cuttlefish_desc": "Maleńka mątwa chodząca po dnie i pulsująca jaskrawymi barwami: fioletem, różem i żółcią.",
  "species_giant_cuttlefish_name": "Mątwa olbrzymia",
  "species_giant_cuttlefish_desc": "Największa mątwa świata, słynąca z masowych zgromadzeń tarłowych w Australii Południowej.",
  "species_bigfin_reef_squid_name": "Kałamarnica rafowa wielkopłetwa",
  "species_bigfin_reef_squid_desc": "Ławicowa kałamarnica często spotykana podczas nurkowań nocnych, zwabiana światłem latarek.",
  "species_caribbean_reef_squid_name": "Kałamarnica karaibska",
  "species_caribbean_reef_squid_desc": "Ciekawska kałamarnica, często unosząca się w małych grupach przy krawędziach raf na Karaibach.",
  "species_bobtail_squid_name": "Sepiola",
  "species_bobtail_squid_desc": "Maleńki nocny głowonóg, który za dnia zakopuje się w piasku; cenione znalezisko w nurkowaniu typu muck.",
  "species_chambered_nautilus_name": "Łodzik piękny",
  "species_chambered_nautilus_desc": "Prastara żywa skamieniałość ze zwiniętą muszlą, rzadko widywana przez nurków, na dużych głębokościach o świcie.",
  "species_spanish_dancer_name": "Tancerka hiszpańska",
  "species_spanish_dancer_desc": "Największy gatunek ślimaka nagoskrzelnego; pływa, falując czerwonym płaszczem niczym tancerka flamenco.",
  "species_chromodoris_willani_name": "Chromodoris Willana",
  "species_chromodoris_willani_desc": "Efektowny niebiesko-czarny ślimak nagoskrzelny z białym obrzeżeniem, pospolity w Indo-Pacyfiku.",
  "species_chromodoris_lochi_name": "Chromodoris Locha",
  "species_chromodoris_lochi_desc": "Niebieski ślimak nagoskrzelny z ciemnymi liniami i białą obwódką, spotykany w całym tropikalnym Pacyfiku.",
  "species_chromodoris_magnifica_name": "Chromodoris wspaniała",
  "species_chromodoris_magnifica_desc": "Olśniewający niebiesko-biało-pomarańczowy ślimak nagoskrzelny, spotykany na rafach koralowych Indo-Pacyfiku.",
  "species_chromodoris_annae_name": "Chromodoris Anny",
  "species_chromodoris_annae_desc": "Ciemnoniebieski ślimak nagoskrzelny z czarnymi liniami oraz rinoforami i skrzelami o pomarańczowych końcach.",
  "species_nembrotha_kubaryana_name": "Zmienny ślimak neonowy",
  "species_nembrotha_kubaryana_desc": "Ciemnozielony ślimak nagoskrzelny z jaskrawymi pomarańczowymi lub czerwonymi znaczeniami, żywiący się osłonicami.",
  "species_nembrotha_cristata_name": "Nembrota grzebieniasta",
  "species_nembrotha_cristata_desc": "Czarny ślimak nagoskrzelny z jaskrawozielonymi brodawkami i prążkami, spotykany na rafach Indo-Pacyfiku.",
  "species_phyllidia_varicosa_name": "Filidia brodawkowata",
  "species_phyllidia_varicosa_desc": "Niebieskoszary ślimak nagoskrzelny z wypukłymi guzkami o żółtych szczytach, trujący dla drapieżników.",
  "species_phyllidia_ocellata_name": "Filidia oczkowana",
  "species_phyllidia_ocellata_desc": "Biały ślimak nagoskrzelny z wypukłymi guzkami w różowych obwódkach, spotykany na tropikalnych rafach.",
  "species_pikachu_nudibranch_name": "Ślimak Pikachu",
  "species_pikachu_nudibranch_desc": "Maleńki żółto-czarny ślimak morski przypominający postać z kreskówki, spotykany na Pacyfiku.",
  "species_anna_rosefieldi_name": "Ślimak nagoskrzelny Roboastra",
  "species_anna_rosefieldi_desc": "Drapieżny ślimak nagoskrzelny o ciemnym ciele z jasnymi podłużnymi pasami, polujący na inne ślimaki.",
  "species_lettuce_sea_slug_name": "Ślimak sałatowy",
  "species_lettuce_sea_slug_desc": "Pofalowany zielony ślimak morski, który zatrzymuje chloroplasty z glonów i wykorzystuje je do fotosyntezy.",
  "species_blue_dragon_nudibranch_name": "Ślimak niebieski smok",
  "species_blue_dragon_nudibranch_desc": "Długi ślimak nagoskrzelny z grupy eolidów, o wyrostkach grzbietowych z niebieskimi końcami, w których żyją symbiotyczne zooksantelle.",
  "species_gloomy_nudibranch_name": "Ślimak nagoskrzelny ponury",
  "species_gloomy_nudibranch_desc": "Ciemny niebieskozielony ślimak nagoskrzelny z grzbietami o niebieskich krawędziach, pospolity na rafach Indo-Pacyfiku.",
  "species_ocellined_nudibranch_name": "Ślimak nagoskrzelny oczkowany",
  "species_ocellined_nudibranch_desc": "Biały ślimak nagoskrzelny, którego grzbiety z pomarańczowymi liniami tworzą na płaszczu geometryczne wzory.",
  "species_glossodoris_cincta_name": "Ślimak nagoskrzelny Glossodoris",
  "species_glossodoris_cincta_desc": "Kremowy ślimak nagoskrzelny z ciemnobrązową obwódką i pomarańczowym obrzeżeniem płaszcza.",
  "species_jorunna_funebris_name": "Ślimak nagoskrzelny kropkowany",
  "species_jorunna_funebris_desc": "Biały ślimak nagoskrzelny pokryty brodawkami czuciowymi o czarnych końcach, przypominający puszystego króliczka.",
  "species_ceratosoma_trilobatum_name": "Ślimak nagoskrzelny trójpłatowy",
  "species_ceratosoma_trilobatum_desc": "Duży ślimak nagoskrzelny z wysokim rogiem grzbietowym i bocznymi płatami, w odcieniach fioletu i żółci.",
  "species_hypselodoris_apolegma_name": "Hypselodoris purpurowy",
  "species_hypselodoris_apolegma_desc": "Elegancki fioletowy ślimak nagoskrzelny z białą obwódką płaszcza, spotykany na rafach Indo-Pacyfiku.",
  "species_hypselodoris_bullockii_name": "Hypselodoris Bullocka",
  "species_hypselodoris_bullockii_desc": "Różowo-fioletowy ślimak nagoskrzelny z rinoforami o żółtych końcach, żyjący na rafach Indo-Pacyfiku.",
  "species_flabellina_exoptata_name": "Flabellina upragniona",
  "species_flabellina_exoptata_desc": "Półprzezroczysty ślimak nagoskrzelny z grupy eolidów, o pomarańczowych wyrostkach grzbietowych z fioletowymi końcami, spotykany w wodach tropikalnych.",
  "species_risbecia_tryoni_name": "Risbecia Tryona",
  "species_risbecia_tryoni_desc": "Duży brązowo-niebieski ślimak nagoskrzelny, często spotykany w parach godowych na rafach Indo-Pacyfiku.",
  "species_goniobranchus_kuniei_name": "Ślimak nagoskrzelny Kunie",
  "species_goniobranchus_kuniei_desc": "Biały ślimak nagoskrzelny w pomarańczowe plamki, z fioletowym obrzeżeniem płaszcza, spotykany na zachodnim Pacyfiku.",
  "species_mexichromis_multituberculata_name": "Ślimak nagoskrzelny wieloguzkowy",
  "species_mexichromis_multituberculata_desc": "Fioletowo-biały ślimak nagoskrzelny z wypukłymi guzkami i wyrostkami o pomarańczowych końcach.",
  "species_chromodoris_dianae_name": "Chromodoris Diany",
  "species_chromodoris_dianae_desc": "Jaskrawoniebieski ślimak nagoskrzelny z czarnymi pasami i pomarańczowymi skrzelami, spotykany na zachodnim Pacyfiku.",
  "species_phyllodesmium_poindimiei_name": "Ślimak nagoskrzelny słoneczny",
  "species_phyllodesmium_poindimiei_desc": "Półprzezroczysty ślimak nagoskrzelny z grupy eolidów, o rozgałęzionych wyrostkach grzbietowych, w których żyją zooksantelle.",
  "species_chromodoris_elisabethina_name": "Chromodoris Elżbiety",
  "species_chromodoris_elisabethina_desc": "Ślimak nagoskrzelny w niebieskie i żółte linie, z białą obwódką płaszcza, pospolity w Azji Południowo-Wschodniej.",
  "species_doridella_batava_name": "Doryda batawska",
  "species_doridella_batava_desc": "Zmiennie ubarwiony, od czarnego po brązowy, ślimak nagoskrzelny z grupy doryd, spotykany pod kamieniami i w rumoszu na rafach Indo-Pacyfiku.",
  "species_tiger_cowrie_name": "Porcelanka tygrysia",
  "species_tiger_cowrie_desc": "Duża plamista porcelanka spotykana na tropikalnych rafach, często częściowo okryta własnym płaszczem.",
  "species_tritons_trumpet_name": "Trąba trytona",
  "species_tritons_trumpet_desc": "Duży drapieżny ślimak, naturalny wróg korony cierniowej.",
  "species_queen_conch_name": "Skrzydelnik olbrzymi",
  "species_queen_conch_desc": "Charakterystyczny duży skrzydelnik z karaibskich łąk trawy morskiej, o wyróżniającej się różowej wardze wewnętrznej.",
  "species_banded_coral_shrimp_name": "Krewetka bokser",
  "species_banded_coral_shrimp_desc": "Krewetka czyszcząca w czerwono-białe pasy, z długimi białymi czułkami, spotykana w szczelinach rafy.",
  "species_mantis_shrimp_name": "Rawka błazen",
  "species_mantis_shrimp_desc": "Barwny drapieżnik z potężnymi maczugowatymi odnóżami, którymi potrafi rozbijać muszle.",
  "species_cleaner_shrimp_name": "Szkarłatna krewetka czyszcząca",
  "species_cleaner_shrimp_desc": "Jaskrawa czerwono-biała krewetka, która zakłada stacje czyszczące i obsługuje w nich ryby rafowe.",
  "species_pederson_cleaner_shrimp_name": "Krewetka czyszcząca Pedersona",
  "species_pederson_cleaner_shrimp_desc": "Półprzezroczysta karaibska krewetka czyszcząca żyjąca wśród czułków ukwiałów.",
  "species_harlequin_shrimp_name": "Krewetka arlekin",
